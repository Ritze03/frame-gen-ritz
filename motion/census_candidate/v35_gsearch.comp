#version 450
#extension GL_GOOGLE_include_directive : require
// MotionVersion::V3, Settings::v3Motion = 1 (V3.5, task 162): the wide census search of one coarse level (gpu/V3.md 3.18, "The ground search").
// Why: on a plain road at speed V3's cost curves are flat at every level (the 5x5 high-pass leaves nothing of a smeared, low-contrast asphalt, the lane lines run along the motion)
// and its search only ever refines around the parents' vectors (+-1 level px per iteration), so no level finds a motion the top level did not already have; the road stays at zero.
// What it does: for every block of level pc.lvl (4 x 4 px, window 8 x 8 with the 2 px apron, as the search's) an exhaustive search over the integer vectors of +-GR level px of a
// census cost on the raw luma: the code of a pixel says which of its 8 neighbours at +-2 level px are brighter (a second bit: darker) than it by more than GS_EPS; the cost is the
// share of differing bits over the window's pixels whose target is inside the level (at least half of the window). A census code is blind to any monotone lighting change (gain, offset,
// a gradient) and keeps the soft shading, tyre marks and patches a 5x5 high-pass removes; a window of 8 x 8 at a coarse level spans 64 .. 128 px.
// Output: the block's record in slot 1 of its level (free until the level's second search iteration writes it, which is after the one iteration that reads it) =
// (vx, vy, confidence, best cost): the best vector, its confidence (how much better it is than zero and than the best vector at least 3 px away from it, relative to the cost level),
// both directions (z). v3_search (-DV35) takes it as candidate 11 of iteration 0 of the level, without distance penalty and with a bonus of GB x confidence, so on a flat block
// where V3's own cost is indifferent the census vector wins, and where V3's cost clearly objects it does not.
#include "common.glsl"
#include "v3_common.glsl"
#include "v3_est.glsl"
#ifndef GS_WG
#define GS_WG 64                         // workgroup size (a small group and a third of the shared memory of a range-12 build: many groups in flight on the fine levels)
#endif
layout(local_size_x = GS_WG) in;

#ifndef GMAX
#define GMAX 6                           // the largest range (pc.n, level px) this pass takes
#endif
// per dispatch (pc.n = the range GR in level px, at most GMAX): NC = 2 GR + 1 candidates per axis, the target region of the window RW = 8 + 2 GR, plus the census neighbourhood (+-2) SW = RW + 4.
// pc.mode bit 9 (512): the search is centred on the vector of the parent block (x2) instead of on zero.

const float GS_EPS = 0.5;                // levels: a neighbour counts as brighter / darker above this difference
const float BAD = 4.0;

shared float slum[(12 + 2 * GMAX) * (12 + 2 * GMAX)];              // luma of frame f1 around the window, clamped to the level
shared uint scen[(8 + 2 * GMAX) * (8 + 2 * GMAX)];               // census codes of frame f1 over the target region
shared float sy0[144];                   // luma of frame f0 around the window (12 x 12)
shared uint sc0[64];                     // census codes of the window pixels of frame f0
shared int sval[64];
shared float cc[(2 * GMAX + 1) * (2 * GMAX + 1)];
shared float tb[GS_WG], ts[GS_WG], tsum[GS_WG];
shared int ti[GS_WG];

float rawY(const V3Lv L, int f, ivec2 p) {
    p = clamp(p, ivec2(0), ivec2(L.w - 1, L.h - 1));
    return unpackHalf2x16(pyr[2 * L.off + f * L.w * L.h + p.y * L.w + p.x].x).x;
}
// the code of a pixel from a staged luma array (row length n, centre index c): 8 neighbours at +-2 (x2 bits)
const ivec2 NB[8] = ivec2[8](ivec2(-2, 0), ivec2(2, 0), ivec2(0, -2), ivec2(0, 2), ivec2(-2, -2), ivec2(-2, 2), ivec2(2, -2), ivec2(2, 2));
uint codeAt(float centre, int idx, int n, bool f1) {
    uint c = 0u;
    for (int k = 0; k < 8; k++) {
        const float d = (f1 ? slum[idx + NB[k].y * n + NB[k].x] : sy0[idx + NB[k].y * n + NB[k].x]) - centre;
        c |= (d > GS_EPS ? 1u : 0u) << uint(2 * k);
        c |= (d < -GS_EPS ? 1u : 0u) << uint(2 * k + 1);
    }
    return c;
}

void main() {
    const int tid = int(gl_LocalInvocationIndex);
    const int dir = int(gl_WorkGroupID.z);
    const int f0 = dir, f1 = 1 - dir;
    const ivec2 blk = ivec2(gl_WorkGroupID.xy);
    const int l = pc.lvl;
    const V3Lv L = v3Lv(l);
    const ivec2 wo = blk * 4 - 2;   // the window of the role-0 frame (levels >= 1)
    const int GR = pc.n, NC = 2 * GR + 1, RW = 8 + 2 * GR, SW = RW + 4;
    ivec2 cen = ivec2(0);           // the centre of the search: zero, or the parent's vector x2
    if ((pc.mode & 512) != 0) {
        int P, Bw, nLev;
        v3Totals(P, Bw, nLev);
        const V3Lv Lp = v3Lv(l + 1);
        const int pfin = (l + 1 == nLev - 1) ? 0 : 1;
        const ivec2 pb = clamp(blk >> 1, ivec2(0), ivec2(Lp.gw - 1, Lp.gh - 1));
        const int po = v3BlkIdx(Lp, dir, pfin, pb);
        cen = ivec2(roundEven(2.0 * vec2(fl[po], fl[po + 1])));
    }
    // stage: frame f1 luma over the target region +-2, frame f0 luma over the window +-2
    for (int i = tid; i < SW * SW; i += GS_WG) slum[i] = rawY(L, f1, wo + cen - GR - 2 + ivec2(i % SW, i / SW));
    for (int i = tid; i < 144; i += GS_WG) sy0[i] = rawY(L, f0, wo - 2 + ivec2(i % 12, i / 12));
    for (int ti_ = tid; ti_ < 64; ti_ += GS_WG) {
        const ivec2 x = wo + ivec2(ti_ & 7, ti_ >> 3);
        sval[ti_] = (all(greaterThanEqual(x, ivec2(0))) && all(lessThan(x, ivec2(L.w, L.h)))) ? 1 : 0;
    }
    barrier();
    for (int i = tid; i < RW * RW; i += GS_WG) {
        const int sx = i % RW + 2, sy = i / RW + 2;
        const int idx = sy * SW + sx;
        scen[i] = codeAt(slum[idx], idx, SW, true);
    }
    for (int ti_ = tid; ti_ < 64; ti_ += GS_WG) {
        const int id0 = ((ti_ >> 3) + 2) * 12 + (ti_ & 7) + 2;
        sc0[ti_] = codeAt(sy0[id0], id0, 12, false);
    }
    barrier();
    int nWin = 0;
    for (int i = 0; i < 64; i++) nWin += sval[i];
    // the costs of all candidates (10 per thread)
    float bm = 1e9;
    int bi = 0;
    float sumc = 0.0, cnt = 0.0;
    for (int c = tid; c < NC * NC; c += GS_WG) {
        const ivec2 v = ivec2(c % NC - GR, c / NC - GR);
        int s = 0, n = 0;
        for (int i = 0; i < 64; i++) {
            const ivec2 d = ivec2(i & 7, i >> 3);
            const ivec2 t = wo + d + cen + v;
            const bool ok = sval[i] != 0 && all(greaterThanEqual(t, ivec2(0))) && all(lessThan(t, ivec2(L.w, L.h)));
            if (ok) {
                s += bitCount(sc0[i] ^ scen[(d.y + v.y + GR) * RW + d.x + v.x + GR]);
                n++;
            }
        }
        float cost = BAD;
        if (n * 2 >= nWin && n > 0) cost = float(s) / float(n * 16);
        cc[c] = cost;
        if (cost < BAD) { sumc += cost; cnt += 1.0; }
        const float pen = cost + 1e-5 * float(abs(v.x) + abs(v.y));   // ties: the shorter vector
        if (pen < bm) { bm = pen; bi = c; }
    }
    tb[tid] = bm; ti[tid] = bi; tsum[tid] = sumc;
    ts[tid] = cnt;
    barrier();
    float gm = tb[0];
    int gi = ti[0];
    float ssum = tsum[0], scnt = ts[0];
    for (int i = 1; i < GS_WG; i++) {
        if (tb[i] < gm || (tb[i] == gm && ti[i] < gi)) { gm = tb[i]; gi = ti[i]; }
        ssum += tsum[i]; scnt += ts[i];
    }
    const ivec2 v0 = ivec2(gi % NC - GR, gi / NC - GR);
    const int far = GR >= 12 ? 3 : 2;   // the best cost at least 3 px (2 for a refinement range) from the best
    float sm = 1e9;
    for (int c = tid; c < NC * NC; c += GS_WG) {
        const ivec2 d = abs(ivec2(c % NC - GR, c / NC - GR) - v0);
        if (max(d.x, d.y) >= far && cc[c] < sm) sm = cc[c];
    }
    barrier();   // everybody has read tb / ti
    tb[tid] = sm;
    barrier();
    float gs = tb[0];
    for (int i = 1; i < GS_WG; i++) gs = min(gs, tb[i]);
    if (tid == 0) {
        const float cb = cc[gi], cz = cc[GR * NC + GR];
        // confidence: distinct from the best vector elsewhere (second minimum) and better than zero, relative to the mean cost (a flat window has costs that barely differ)
        float conf = 0.0;
        if (cb < BAD && gs < BAD * 0.5) conf = smoothstep(pc.t0, pc.t1, gs - cb) * smoothstep(0.0, pc.smear, cz - cb);
        const int o = v3BlkIdx(L, dir, 1, blk);
        fl[o] = float(cen.x + v0.x); fl[o + 1] = float(cen.y + v0.y); fl[o + 2] = conf; fl[o + 3] = cb;
    }
}
