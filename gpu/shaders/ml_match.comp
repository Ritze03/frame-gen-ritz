#version 450
#extension GL_GOOGLE_include_directive : require
// MotionVersion::Learned, SPEC.md stages 4a + 4b at level pc.lvl, one thread per pixel of the padded level:
//   4a: h = 2 * upsample2(the coarser level's field), 0 at the coarsest level; written to this level's h (ml_conv.comp's last layer
//       adds 2 * out to it). upsample2 = bilinear with half-pixel centres and edge clamp (torch align_corners=False): per axis
//       up[2k] = 0.75 f[k] + 0.25 f[max(k-1, 0)], up[2k+1] = 0.75 f[k] + 0.25 f[min(k+1, n-1)], rows first, then columns, as
//       reference.py upsample2() (axis 1, then axis 2).
//   4b: the 14-channel (colour net: 25) conv input to act[actOut] (4 groups): sa_d = la(q - h - d), sc_d = lc(q + h + d) for the 9 offsets d
//       (dy outer, dx inner); g0 = (wa, wc, wa - wc, |sa - sc|_0), g1 = |sa - sc|_1..4, g2 = |sa - sc|_5..8, g3 = (hx / 4, hy / 4, 0, 0).
// Float32 in the order of reference.py (precise: no contraction), true bilinear without V1's 1/32 px rounding.
#include "common.glsl"
#include "ml_common.glsl"
layout(local_size_x = 16, local_size_y = 16) in;

// The colour variant (pc.ext = 2, SPEC.md section 10.3): 25 channels, 7 groups: g3 = (hx / 4, hy / 4, Cb_a - Cb_c, Cr_a - Cr_c) at d = 0,
// g4 .. g6 = the 9 colour costs |dCb_d| + |dCr_d| (channels 16 .. 24; 4 + 4 + 1). A specialization constant: the luma net's pipeline is
// the luma pass alone.
layout(constant_id = 25) const int ML_COLOUR = 0;

// reference.py bilinear(): clamp to edge, x0 = floor, x1 = min(x0 + 1, w - 1); taps summed left to right. The four tap indices and
// weights depend on the position only, so a colour net's chroma planes (same coordinates as the luma, SPEC.md section 10.3) reuse them.
struct Tap { int i00, i01, i10, i11; float w00, w01, w10, w11; };
Tap tapAt(int w, int h, float x, float y) {
    precise float xc = clamp(x, 0.0, float(w - 1)), yc = clamp(y, 0.0, float(h - 1));
    float x0f = floor(xc), y0f = floor(yc);
    int x0 = int(x0f), y0 = int(y0f);
    int x1 = min(x0 + 1, w - 1), y1 = min(y0 + 1, h - 1);
    precise float fx = xc - x0f, fy = yc - y0f;
    precise float w00 = (1.0 - fy) * (1.0 - fx), w01 = (1.0 - fy) * fx, w10 = fy * (1.0 - fx), w11 = fy * fx;
    return Tap(y0 * w + x0, y0 * w + x1, y1 * w + x0, y1 * w + x1, w00, w01, w10, w11);
}
float samp(int off, Tap t) {
    precise float r = ml[off + t.i00] * t.w00 + ml[off + t.i01] * t.w01 + ml[off + t.i10] * t.w10 + ml[off + t.i11] * t.w11;
    return r;
}

vec2 hAt(int off, int w, int x, int y) { int i = off + 2 * (y * w + x); return vec2(ml[i], ml[i + 1]); }

void main() {
    if (mlDup()) return;
    int lw = pc.pw >> pc.lvl, lh = pc.ph >> pc.lvl, n = lw * lh;
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    if (q.x >= lw || q.y >= lh) return;
    precise vec2 h = vec2(0.0);
    if (pc.lvl < ML_LEVELS - 1) {
        int cw = lw >> 1, ch = lh >> 1, co = mlH(pc.lvl + 1);
        int kx = q.x >> 1, ky = q.y >> 1;
        int nx = (q.x & 1) == 0 ? max(kx - 1, 0) : min(kx + 1, cw - 1);
        int ny = (q.y & 1) == 0 ? max(ky - 1, 0) : min(ky + 1, ch - 1);
        precise vec2 g0 = 0.75 * hAt(co, cw, kx, ky) + 0.25 * hAt(co, cw, kx, ny);   // rows first
        precise vec2 g1 = 0.75 * hAt(co, cw, nx, ky) + 0.25 * hAt(co, cw, nx, ny);
        h = (0.75 * g0 + 0.25 * g1) * 2.0;                                              // then columns, x2 (level pixels)
    }
    int ho = mlH(pc.lvl) + 2 * (q.y * lw + q.x);
    ml[ho] = h.x;
    ml[ho + 1] = h.y;
    int la = mlPyr(pc.lvl), lc = la + n;
    int xa = mlX(pc.lvl);   // the colour variant's planes of this level: Cb_a, Cb_c, Cr_a, Cr_c (n each)
    float cost[9], ccost[9];
    float wa = 0.0, wc = 0.0, dcb0 = 0.0, dcr0 = 0.0;
    vec2 p = vec2(q);
    for (int dy = -1; dy <= 1; dy++)
        for (int dx = -1; dx <= 1; dx++) {
            precise float ax = p.x - h.x - float(dx), ay = p.y - h.y - float(dy);
            precise float cx = p.x + h.x + float(dx), cy = p.y + h.y + float(dy);
            Tap ta = tapAt(lw, lh, ax, ay), tc = tapAt(lw, lh, cx, cy);
            float sa = samp(la, ta), sc = samp(lc, tc);
            const int k = 3 * (dy + 1) + dx + 1;
            cost[k] = abs(sa - sc);
            if (dx == 0 && dy == 0) { wa = sa; wc = sc; }
            if (ML_COLOUR != 0) {
                float dcb = samp(xa, ta) - samp(xa + n, tc), dcr = samp(xa + 2 * n, ta) - samp(xa + 3 * n, tc);
                ccost[k] = abs(dcb) + abs(dcr);
                if (dx == 0 && dy == 0) { dcb0 = dcb; dcr0 = dcr; }
            }
        }
    int o = pc.actOut + q.y * lw + q.x;
    actStore(o, vec4(wa, wc, wa - wc, cost[0]));
    actStore(o + n, vec4(cost[1], cost[2], cost[3], cost[4]));
    actStore(o + 2 * n, vec4(cost[5], cost[6], cost[7], cost[8]));
    actStore(o + 3 * n, vec4(h * 0.25, dcb0, dcr0));
    if (ML_COLOUR != 0) {
        actStore(o + 4 * n, vec4(ccost[0], ccost[1], ccost[2], ccost[3]));
        actStore(o + 5 * n, vec4(ccost[4], ccost[5], ccost[6], ccost[7]));
        actStore(o + 6 * n, vec4(ccost[8], 0.0, 0.0, 0.0));
    }
}
