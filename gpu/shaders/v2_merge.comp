#version 450
#extension GL_GOOGLE_include_directive : require
// V2, estimate (flow res, after v2_rescue; the content rescue, step 3 of 4, I11): writes the rescued vectors into the edge-aware
// field hE. At a flow pixel m that won a vote (v2_rescue.comp), the winner's half-vector u replaces hE(m) if it explains m well
// enough: its 3x3 mean |a(y - u) - c(y + u)| at most the rescue knob (the match quality the vote accepted; a fast object's match is
// rarely exact: perspective, aperture) or at most 4 levels above hE's. Both frames see the object there and the field's vector
// merely maps the background around it, so the object (in front) wins; a vector that explains m far better stays. An unvoted pixel
// with at least 3 votes in its 5x5 tries the best of them the same way (the votes of an object are sparse: perspective, flat parts;
// the test keeps the vector to where it explains the content). Each pixel writes only itself (its field vector and its coverage
// word, bit 2 = rescued): the result does not depend on the order.
// Reads the keys, the vectors and field[fE]; writes field[fE].
#include "common.glsl"
#include "motion_v2.glsl"
#include "v2_temporal.glsl"
layout(local_size_x = 16, local_size_y = 16) in;

float cost3(ivec2 m, vec2 v) {
    float e = 0.0;
    for (int j = 0; j < 9; j++) {
        vec2 y = vec2(m + ivec2(j % 3 - 1, j / 3 - 1));
        e += abs(sampleL(pc.offA, y - v, pc.fw, pc.fh) - sampleL(pc.offC, y + v, pc.fw, pc.fh));
    }
    return e * (1.0 / 9.0);
}

const int TS = 16, TK = TS + 4;
shared uint sk[TK * TK];   // the keys of the tile + 2
shared uint anyKey, nRes;

void main() {
    if (u[V2_U_VOTES] == 0u) return;   // (nothing to merge; uniform)
    int lid = int(gl_LocalInvocationIndex);
    int ro = v2ROff(), n = pc.fw * pc.fh;
    if (lid == 0) { anyKey = 0u; nRes = 0u; }
    barrier();
    ivec2 t0 = ivec2(gl_WorkGroupID.xy) * TS - 2;
    for (int i = lid; i < TK * TK; i += TS * TS) {
        ivec2 y = t0 + ivec2(i % TK, i / TK);
        uint k = all(greaterThanEqual(y, ivec2(0))) && all(lessThan(y, ivec2(pc.fw, pc.fh))) ? v2b[ro + n + y.y * pc.fw + y.x] : 0u;
        sk[i] = k;
        if (k != 0u) atomicOr(anyKey, 1u);
    }
    barrier();
    if (anyKey == 0u) return;   // (uniform)
    ivec2 l = ivec2(gl_LocalInvocationID.xy);
    ivec2 m = ivec2(gl_GlobalInvocationID.xy);
    bool done = false;
    if (m.x < pc.fw && m.y < pc.fh) {
        uint key = sk[(l.y + 2) * TK + l.x + 2];
        if (key == 0u) {
            int votes = 0;
            for (int j = 0; j < 25; j++) {
                uint k = sk[(l.y + j / 5) * TK + l.x + j % 5];
                votes += j != 12 && k != 0u ? 1 : 0;
                key = max(key, k);
            }
            if (votes < 3) key = 0u;
        }
        if (key != 0u) {
            int src = int(0x7FFFFFu - (key & 0x7FFFFFu));
            vec2 uh = unpackV(v2b[ro + 2 * n + src]);
            vec2 h = field[pc.fE + m.y * pc.fw + m.x];
            if (cost3(m, uh) <= max(cost3(m, h) + 4.0, pc.rescue)) {
                field[pc.fE + m.y * pc.fw + m.x] = uh;
                v2b[ro + m.y * pc.fw + m.x] |= 4u;   // rescued (v2_occl.comp copies it into the occlusion map: not held)
                done = true;
            }
        }
    }
    if (done) atomicAdd(nRes, 1u);
    barrier();
    if (lid == 0 && nRes > 0u) atomicAdd(u[V2_U_RESCUED], nRes);
}
