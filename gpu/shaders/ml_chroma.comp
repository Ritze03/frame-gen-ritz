#version 450
#extension GL_GOOGLE_include_directive : require
// MotionVersion::Learned, the colour variant's per-frame planes (a colour pass: one variant per format; ml-fg export/SPEC.md section
// 10.1, reference.py flow_chroma()): for both frames, the flow-res chroma Cb = 0.564 (B - Yf), Cr = 0.713 (R - Yf), Yf = 0.299 R +
// 0.587 G + 0.114 B the UNROUNDED float luma (not P_LUMA's integer one), no offset, in 8-bit levels, then the same 2x2 area average
// as the luma (the mean of the valid pixels of the cell). One thread per flow pixel; the output goes to ml_common.glsl's flow-res
// extra planes (mlFlowX), ml_pyr.comp pads / scales / pyramids them. Same pixels as P_LUMA reads (texPrev / texCurr). Float32 in
// the order of numpy: no contraction (precise), (R * .299 + G * .587) + B * .114, cells summed (p00 + p01) + (p10 + p11).
// Other formats: the R'G'B' levels of the format's mismatch metric (format.glsl, as ml_dup.comp), YCbCr converted to R'G'B'.
#include "common.glsl"
#include "ml_common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;

vec3 rgbLevels(bool cur, ivec2 p) {
#if defined(FG_YUV)
    float y = fgLuma(cur ? texelFetch(texCurr, p, 0).r : texelFetch(texPrev, p, 0).r);
    vec2 c = (cur ? texelFetch(texCurrC, p >> 1, 0).rg : texelFetch(texPrevC, p >> 1, 0).rg) * YU_SCALE - 128.0;   // (Cb, Cr)
    return vec3(y + YU_RCR * c.y, y + YU_GCB * c.x + YU_GCR * c.y, y + YU_BCB * c.x);
#elif defined(FG_FORMAT_F16)
    return fgMetric((cur ? texelFetch(texCurr, p, 0) : texelFetch(texPrev, p, 0)).rgb);
#else
    return FG_FETCH((cur ? texelFetch(texCurr, p, 0) : texelFetch(texPrev, p, 0)).rgb);
#endif
}

void main() {
    if (mlDup()) return;
    ivec2 o = ivec2(gl_GlobalInvocationID.xy);
    if (o.x >= pc.fw || o.y >= pc.fh) return;
    const int at = o.y * pc.fw + o.x, pl = pc.fw * pc.fh;
    for (int f = 0; f < 2; f++) {
        precise float pb[4], pr[4];
        int n = 0;
        for (int j = 0; j < 2; j++)
            for (int i = 0; i < 2; i++) {
                ivec2 p = 2 * o + ivec2(i, j);
                precise float b = 0.0, r = 0.0;
                if (p.x < pc.W && p.y < pc.H) {
                    vec3 c = rgbLevels(f != 0, p);
                    precise float y = (c.r * 0.299 + c.g * 0.587) + c.b * 0.114;
                    b = 0.564 * (c.b - y);
                    r = 0.713 * (c.r - y);
                    n++;
                }
                pb[2 * j + i] = b;
                pr[2 * j + i] = r;
            }
        precise float sb = (pb[0] + pb[1]) + (pb[2] + pb[3]);
        precise float sr = (pr[0] + pr[1]) + (pr[2] + pr[3]);
        ml[mlFlowX() + f * pl + at] = n == 4 ? sb * 0.25 : sb / float(n);          // plane 0 (Cb) of frame f
        ml[mlFlowX() + (2 + f) * pl + at] = n == 4 ? sr * 0.25 : sr / float(n);    // plane 1 (Cr)
    }
}
