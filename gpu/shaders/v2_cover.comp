#version 450
#extension GL_GOOGLE_include_directive : require
// V2, estimate (flow res, after v2_smooth; the content rescue, step 1 of 4, I11): which pixels of prev and of curr does the generated
// frame show? Every flow pixel q of the midpoint grid shows, with its edge-aware vector h = hE(q):
//   two-sided (its 3x3 mean |a(y - h) - c(y + h)| (nearest taps) below the middle of the trust ramp): a(q - h) and c(q + h)
//   held (above it: the resolve will show the nearer real frame there): a(q) and c(q) (either, by t; both count as shown)
// and sets the coverage bits of those source pixels (bit 0: a, bit 1: c; atomicOr, so the result does not depend on the order; a
// tap outside the frame covers nothing). v2_smooth.comp cleared the bits. v2_rescue.comp then looks for content that NEITHER
// frame's copy shows: an object both frames see, which the field paints over with a vector that maps background to background.
// Reads field[fE] (hE), luma of the finest level; writes the coverage bits (v2_temporal.glsl v2ROff()).
#include "common.glsl"
#include "motion_v2.glsl"
#include "v2_temporal.glsl"
layout(local_size_x = 16, local_size_y = 16) in;

void main() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    if (q.x >= pc.fw || q.y >= pc.fh) return;
    vec2 h = field[pc.fE + q.y * pc.fw + q.x];
    float e = 0.0;   // (nearest taps: a hold estimate, not the resolve's mismatch)
    ivec2 hi = ivec2(roundEven(h));
    for (int j = 0; j < 9; j++) {
        ivec2 y = q + ivec2(j % 3 - 1, j / 3 - 1);
        e += abs(L(pc.offA, y.x - hi.x, y.y - hi.y, pc.fw, pc.fh) - L(pc.offC, y.x + hi.x, y.y + hi.y, pc.fw, pc.fh));
    }
    int cov = v2ROff();
    if (e * (1.0 / 9.0) >= pc.trust0 + 0.5 / pc.trustScale) {   // held
        atomicOr(v2b[cov + q.y * pc.fw + q.x], 3u);
        return;
    }
    ivec2 qa = ivec2(roundEven(vec2(q) - h)), qc = ivec2(roundEven(vec2(q) + h));
    if (all(greaterThanEqual(qa, ivec2(0))) && all(lessThan(qa, ivec2(pc.fw, pc.fh)))) atomicOr(v2b[cov + qa.y * pc.fw + qa.x], 1u);
    if (all(greaterThanEqual(qc, ivec2(0))) && all(lessThan(qc, ivec2(pc.fw, pc.fh)))) atomicOr(v2b[cov + qc.y * pc.fw + qc.x], 2u);
}
