#version 450
#extension GL_GOOGLE_include_directive : require
// V2 Quality, coverage step 1 (flow resolution, once per estimate): every midpoint location m claims its footprint pixel in prev
// (m - h) and in curr (m + h), h the cleaned block field bilinear at m, with key = |luma_a(m - h) - luma_c(m + h)| (bilinear); the
// pixel keeps the smallest packed key | vector (atomicMin). Also stores m's own packed claim. See v2_quality.glsl.
#include "common.glsl"
#include "v2_motion.glsl"
#include "v2_quality.glsl"
layout(local_size_x = 8, local_size_y = 8) in;

float keyAt(vec2 pa, vec2 pc_) {
    if (pc.t[2] < 0.5) return abs(qLuma(0, pa) - qLuma(qN(), pc_));
    float k = 0.0;
    for (int j = 0; j < 4; j++) {
        vec2 o = vec2((j & 1) != 0 ? 0.5 : -0.5, (j & 2) != 0 ? 0.5 : -0.5);
        k += abs(qLuma(0, pa + o) - qLuma(qN(), pc_ + o));
    }
    return 0.25 * k;
}

void main() {
    ivec2 m = ivec2(gl_GlobalInvocationID.xy);
    if (m.x >= pc.fw || m.y >= pc.fh) return;
    vec2 h = qF(m);
    vec2 pa = vec2(m) - h, pc_ = vec2(m) + h;
    float k = keyAt(pa, pc_);
    uint w = qPack(uint(k * Q_KEY + 0.5), qQuant(h));
    int N = qN(), me = m.y * pc.fw + m.x;
    qb[2 * N + me] = w;
    int ia = qPix(pa), ic = qPix(pc_);
    if (ia >= 0) atomicMin(qb[ia], w);
    if (ic >= 0) atomicMin(qb[N + ic], w);
    // a static structured pixel (a HUD element, subtitle text) where the field moves: claims its own place in both frames
    if (pc.t[3] > 0.5 && uintBitsToFloat(qb[3 * N + me]) >= 0.5) {
        uint z = qPack(0u, ivec2(0));
        atomicMin(qb[me], z);
        atomicMin(qb[N + me], z);
    }
}
