#version 450
#extension GL_GOOGLE_include_directive : require
// Pass 9: full res. Upsample the per-pixel field, warp a and c (RGB, bilinear, rounded to 8 bit like
// cv2.remap on uint8), e = max-channel |wa - wc|. 4 pixels per thread, packed as bytes into u[].
#include "common.glsl"
#include "motion_v1.glsl"
layout(local_size_x = 8, local_size_y = 8) in;

void main() {
    ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    if (g.x >= E_STRIDE || g.y >= pc.H) return;
    uint packed = 0u;
    for (int i = 0; i < 4; i++) {
        ivec2 p = ivec2(g.x * 4 + i, g.y);
        if (p.x < pc.W) {
            vec3 wa, wc;
            packed |= mismatch(p, wa, wc) << (8 * i);
        }
    }
    u[E_OFF + g.y * E_STRIDE + g.x] = packed;
}
