#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_control_flow_attributes : require
// Observe: fill the masked pixels of the clean copy from their unmasked surroundings, so the motion estimate and
// the warps see plain background where the UI was. For each masked pixel: walk out along 8 directions to the first
// unmasked pixel (at most `reach` steps) and average those REAL pixels weighted 1/distance^2 - the nearest wins, so a
// thin line is filled from just above and below it. A pixel with no unmasked neighbour within reach (the inside of a
// big solid box) is left as the real pixel. Only masked pixels are written.
// One workgroup = one 16x16 tile of the mask rectangle, one thread per pixel (a thread's walks are a dependent chain,
// so more pixels per thread would serialise them); the mask of the tile plus a `reach` halo is staged in shared
// memory so the walks cost no memory reads, and the 8 texture fetches are issued after all walks, independently.
// A tile with no masked pixel exits before staging, one entirely inside the masked area (nothing to walk to) right after. Whole screen: unflagged 32x32 tiles (also in the halo, where
// their mask was never written) count as unmasked, and suppressed frames exit at once.
#include "ui_common.glsl"
layout(set = 0, binding = 1, FG_FMT) uniform writeonly image2D dst;
layout(local_size_x = 16, local_size_y = 16) in;

const int T = 16;
const int RMAX = 16;
const int LS = T + 2 * RMAX;
shared uint ms[LS * LS];   // 0 unmasked, 1 masked, 2 outside the mask rectangle (stop)
shared uint sAny;
shared uint sOpen;   // some staged pixel is not masked (so some walk can end)

void main() {
    ivec2 org = ivec2(pc.maskX, pc.maskY) + ivec2(gl_WorkGroupID.xy) * T;
    if (pc.gate != 0 && !tileLive(org / TILE)) return;
    uint lid = gl_LocalInvocationIndex;
    ivec2 l = ivec2(gl_LocalInvocationID.xy);
    ivec2 p = org + l;
    ivec2 rel0 = p - ivec2(pc.maskX, pc.maskY);
    bool inRect = rel0.x < pc.maskW && rel0.y < pc.maskH;
    if (lid == 0u) { sAny = 0u; sOpen = 0u; }
    barrier();
    if (inRect && maskByte(rel0) != 0u) atomicOr(sAny, 1u);
    barrier();
    if (sAny == 0u) return;   // nothing masked in this tile
    int R = pc.reach;
    int span = T + 2 * R;
    for (int i = int(lid); i < span * span; i += T * T) {
        ivec2 q = org - R + ivec2(i % span, i / span);
        ivec2 rel = q - ivec2(pc.maskX, pc.maskY);
        uint v = 2u;
        if (rel.x >= 0 && rel.y >= 0 && rel.x < pc.maskW && rel.y < pc.maskH) {
            v = 0u;
            if (pc.gate == 0 || tileLive(q / TILE)) v = maskByte(rel) != 0u ? 1u : 0u;
        }
        ms[i] = v;
        if (v != 1u) atomicOr(sOpen, 1u);
    }
    barrier();
    if (sOpen == 0u) return;   // tile and halo entirely masked (inside a big solid area): every walk would find nothing
    ivec2 lp = l + R;
    if (!inRect || ms[lp.y * span + lp.x] != 1u) return;

    // walks: the step at which each direction first meets an unmasked pixel (0 = none within reach / left the rect)
    const ivec2 dirs[8] = ivec2[8](ivec2(1, 0), ivec2(-1, 0), ivec2(0, 1), ivec2(0, -1),
                                   ivec2(1, 1), ivec2(-1, 1), ivec2(1, -1), ivec2(-1, -1));
    int hit[8];
    [[unroll]] for (int d = 0; d < 8; d++) {
        hit[d] = 0;
        for (int s = 1; s <= R; s++) {
            uint v = ms[(lp.y + dirs[d].y * s) * span + lp.x + dirs[d].x * s];
            if (v == 2u) break;
            if (v == 0u) { hit[d] = s; break; }
        }
    }
    vec3 acc = vec3(0.0);
    float wsum = 0.0;
    [[unroll]] for (int d = 0; d < 8; d++) {
        if (hit[d] > 0) {
            float len2 = d < 4 ? 1.0 : 2.0;   // axis steps, diagonals
            float w = 1.0 / (float(hit[d] * hit[d]) * len2);
            acc += texelFetch(src, p + dirs[d] * hit[d], 0).rgb * w;
            wsum += w;
        }
    }
    if (wsum > 0.0) imageStore(dst, p, vec4(acc / wsum, texelFetch(src, p, 0).a));
}
