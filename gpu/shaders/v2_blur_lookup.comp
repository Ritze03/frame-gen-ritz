#version 450
#extension GL_GOOGLE_include_directive : require
// V2, motion blur pass 1 (the refinement grid; blur_lookup.comp on V2's refined field): v2_lookup.comp for every interior sample k of
// the output in one dispatch (z = sample): the field at time t_k, g(q) = h(q - (2t - 1) g(q)), 2 bilinear fixed-point steps from
// h(q) in grid coordinates. Reads the refined midpoint field rf[0..), writes bf[k] (rw x rh, full-resolution half-vector units).
#include "blur_common.glsl"
#include "blur_motion_v2.glsl"
layout(local_size_x = 8, local_size_y = 8) in;

vec2 RF(int x, int y) { return rf[clamp(y, 0, P_RH - 1) * P_RW + clamp(x, 0, P_RW - 1)]; }
vec2 sampleRF(vec2 p) {   // == v2_lookup.comp sampleRF
    ivec2 X = ivec2(roundEven(p * 32.0));
    ivec2 i = X >> 5;
    vec2 f = vec2(X & 31) * (1.0 / 32.0);
    vec2 p00 = RF(i.x, i.y), p01 = RF(i.x + 1, i.y);
    vec2 p10 = RF(i.x, i.y + 1), p11 = RF(i.x + 1, i.y + 1);
    return p00 * ((1.0 - f.y) * (1.0 - f.x)) + p01 * ((1.0 - f.y) * f.x)
         + p10 * (f.y * (1.0 - f.x)) + p11 * (f.y * f.x);
}

void main() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    int k = P_K0 + int(gl_WorkGroupID.z);
    int rw = P_RW, rh = P_RH;
    if (q.x >= rw || q.y >= rh) return;
    float s = 2.0 * pc.t[k] - 1.0;   // exact in float32, like the library's double computation rounded
    vec2 sc = vec2(rw, rh) / vec2(P_W, P_H);
    vec2 g = rf[q.y * rw + q.x];
    for (int i = 0; i < 2; i++)   // LOOKUP_ITERS
        g = sampleRF(vec2(q) - s * (g * sc));
    bf[k * rw * rh + q.y * rw + q.x] = g;
}
