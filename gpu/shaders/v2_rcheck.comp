#version 450
#extension GL_GOOGLE_include_directive : require
// V2, estimate (flow res, after v2_rcheck_e; the content rescue's acceptance check, step 2 of 2, I12, Settings::v2RescueCheck): drops
// the rescues that are not a whole object. The rescue (v2_rescue / merge / close.comp) puts back content both frames show; a wrong or
// partial match shows as a small hard-edged blob of the other content: a dark ring on a light pillar, a blob on a poster during a
// pan (battlefield k14), a dark speck under a tree's canopy or a grey rectangle over tracers (minecraft_rtx_a k39, battlefield k40,
// k56). Per rescued flow pixel m (v2_rcheck_e.comp's flag), over the rescued pixels on the lattice of every second pixel within
// AR = 10 flow px (+-20 full-resolution px at flowScale 2; each lattice pixel stands for 4):
//   area   4 x their count: at least MIN_AREA (PC2 occ0 in this pass = V2Knobs rescueCheck / flowScale^2 flow pixels): the blob is
//          an object, not a speck (a blob smaller than the window is counted about whole from each of its pixels: it goes or stays
//          as one)
//   match  their mean colour mismatch (v2_rcheck_e.comp's e): at most the middle of the trust ramp (the resolve would hold a pixel
//          above it, the rescue exempts it from the hold) times min(area / (4 MIN_AREA), 1): a blob near the smallest area must
//          match better (a pillar's top matched at 17 levels, 284 px: a dark ring; a trunk's 5000 px at 15 levels stay)
// A pixel that fails either is not rescued: its own edge-aware vector comes back (v2_merge / v2_close.comp kept it in vT's slot,
// dead after v2_rescue.comp) and its coverage bits 2 | 3 are cleared (the occlusion map then holds or trusts it as usual).
// Reads the check's scratch (v2GOff()), writes only m's own field vector and coverage word: the result does not depend on the order.
#include "common.glsl"
#include "motion_v2.glsl"
#include "v2_temporal.glsl"
layout(local_size_x = 16, local_size_y = 16) in;

#define MIN_AREA pc.occ0   // (estimate: occ0 is the synth's occlusion ramp, unused here)

const int TS = 16, AR = 10, TR = TS + 2 * AR;
shared uint sw[TR * TR];
shared uint anyRes;

void main() {
    if (u[V2_U_RESCUED] == 0u) return;   // (uniform)
    int lid = int(gl_LocalInvocationIndex);
    if (lid == 0) anyRes = 0u;
    barrier();
    ivec2 t0 = ivec2(gl_WorkGroupID.xy) * TS - AR;
    int go = v2GOff();
    for (int i = lid; i < TR * TR; i += TS * TS) {
        ivec2 y = t0 + ivec2(i % TR, i / TR);
        uint w = all(greaterThanEqual(y, ivec2(0))) && all(lessThan(y, ivec2(pc.fw, pc.fh))) ? v2b[go + y.y * pc.fw + y.x] : 0u;
        sw[i] = w;
        if (w != 0u) atomicOr(anyRes, 1u);
    }
    barrier();
    if (anyRes == 0u) return;   // (uniform)
    ivec2 l = ivec2(gl_LocalInvocationID.xy);
    ivec2 m = ivec2(gl_GlobalInvocationID.xy);
    if (m.x >= pc.fw || m.y >= pc.fh) return;
    if ((sw[(l.y + AR) * TR + l.x + AR] & 1u) == 0u) return;
    int n = 0;
    float es = 0.0;
    for (int dy = -AR; dy <= AR; dy += 2)
        for (int dx = -AR; dx <= AR; dx += 2) {
            uint w = sw[(l.y + AR + dy) * TR + l.x + AR + dx];
            if ((w & 1u) == 0u) continue;
            n++;
            es += float((w >> 8) & 255u);
        }
    float area = float(4 * n);   // flow pixels
    bool keep = area >= MIN_AREA && es <= (pc.trust0 + 0.5 / pc.trustScale) * min(area / (4.0 * MIN_AREA), 1.0) * float(n);
    if (keep) return;
    int i = m.y * pc.fw + m.x;
    field[pc.fE + i] = unpackV(v2b[v2VTOff() + i]);
    v2b[v2ROff() + i] &= ~12u;
}
