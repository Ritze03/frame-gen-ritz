#version 450
#extension GL_GOOGLE_include_directive : require
// V2, synth (t != 0.5 only, the refinement grid): lookup.comp on V2's refined field. The refined field h (rf[0], full-resolution
// half-vector units) lives on the midpoint grid; content at midpoint p sits at q = p + (2t - 1) h(p) at time t, so
// g(q) = h(q - (2t - 1) g(q)): 2 bilinear fixed-point steps started from h(q), in grid coordinates (the vector scaled by the grid's
// resolution; v2_pack.glsl v2LookupT, which the blur passes share). Writes g to rf[rfOut] (packed).
#include "common.glsl"
#include "motion_v2.glsl"
layout(local_size_x = 8, local_size_y = 8) in;

void main() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    if (q.x >= pc.rw || q.y >= pc.rh) return;
    rf[pc.rfOut + q.y * pc.rw + q.x] = packV(v2LookupT(q, pc.s, pc.rw, pc.rh, pc.W, pc.H));   // (reads the midpoint field at rf[0])
}
