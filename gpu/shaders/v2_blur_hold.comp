#version 450
#extension GL_GOOGLE_include_directive : require
// V2, motion blur (after v2_blur_error, V2Knobs holdFeather > 0 only; I11): v2_hold.comp for every interior sample k in one dispatch
// (z = sample): the soft hold edge's map of t_k (v2_hold_core.glsl) from be[k] into be[] after the n mismatch slots
// (blur_motion_v2.glsl holdOff(k)).
#include "blur_common.glsl"
#include "blur_motion_v2.glsl"
layout(local_size_x = 16, local_size_y = 16) in;

int gK = 0;
#define HOLD_EW(p) be[gK * eWords() + (p).y * eStride() + ((p).x >> 2)]
#define HOLD_OUT(c, v) be[holdOff(gK) + (c).y * eStride() + (c).x] = floatBitsToUint(v)
#define HOLD_W P_W
#define HOLD_H P_H
#define HOLD_F pc.feather
#define HOLD_T0 pc.trust0
#define HOLD_TS pc.trustScale
#include "v2_hold_core.glsl"

void main() {
    gK = P_K0 + int(gl_WorkGroupID.z);
    holdMain();
}
