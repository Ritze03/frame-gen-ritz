#version 450
#extension GL_GOOGLE_include_directive : require
// V2, estimate (flow res, after v2_close; the content rescue's acceptance check, step 1 of 2, I12): the mismatch of every rescued
// pixel (v2_merge / v2_close.comp, coverage bits 2 | 3) with its rescued vector, in COLOUR at full resolution (the max-channel
// |a - c| of the two taps at the flow pixel's full-resolution centre, as the resolve's e): the rescue matched luma patches at flow
// resolution, and a wrong match (an object's patch put onto a static surface, the wrong part of a texture) shows here. Written with
// the rescued flag into the check's scratch (v2_temporal.glsl v2GOff(): bit 0 rescued, bits 8-15 e), 0 for every other pixel;
// v2_rcheck.comp reads it.
#include "common.glsl"
#include "motion_v2.glsl"
#include "v2_temporal.glsl"
layout(local_size_x = 16, local_size_y = 16) in;

void main() {
    if (u[V2_U_RESCUED] == 0u) return;   // (nothing rescued; uniform: v2_rcheck.comp returns too)
    ivec2 m = ivec2(gl_GlobalInvocationID.xy);
    if (m.x >= pc.fw || m.y >= pc.fh) return;
    uint w = 0u;
    if ((v2b[v2ROff() + m.y * pc.fw + m.x] & 12u) != 0u) {
        vec2 hf = float(pc.fscale) * field[pc.fE + m.y * pc.fw + m.x];
        vec2 P = (vec2(m) + 0.5) * float(pc.fscale) - 0.5;
        vec3 d = abs(FG_FETCH(sampleRGBRaw(texCurr, P + hf)) - FG_FETCH(sampleRGBRaw(texPrev, P - hf)));
        w = 1u | (uint(min(roundEven(max(d.r, max(d.g, d.b))), 255.0)) << 8);
    }
    v2b[v2GOff() + m.y * pc.fw + m.x] = w;
}
