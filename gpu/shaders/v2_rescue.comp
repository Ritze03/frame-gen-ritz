#version 450
#extension GL_GOOGLE_include_directive : require
// V2, estimate (flow res, after v2_cover; the content rescue, step 2 of 4, I11): content that both frames show and the generated
// frame would show at neither place, i.e. missing content. The case: a thin or fast object (a tree trunk at 100 px per frame, a
// pole) whose midpoint the field gives a vector that maps background to background (sky in a to sky in c, across the object): the
// mismatch is low, so nothing holds it, and the object vanishes. One workgroup per 8 x 8 block of flow pixels of prev (a):
//   1. orphans: pixels x of a that are unused (no pixel of the 3x3 around x is shown, v2_cover.comp bit 0), structured (5x5 luma
//      range >= 10 levels: a flat region shows the same wherever it is taken from) and not what the field shows at x (3x3 mean
//      |a(y) - 0.5 (a(y - h) + c(y + h))| >= 12 levels, h = hE(x)). A block with fewer than 8 of them stops here (nearly all).
//   2. the block's displacement D between the frames (one for the whole block: an object moves as one, and the per-pixel matches
//      of a turning, scaling object scatter): candidates from the field around the block (hE at the centre and 12 flow px out on
//      the axes, the compensated previous field vT with a valid seed, the global median), each with the 3 x 3 displacements 3 flow px apart around
//      it; the cost is the mean over the orphans of their 5-tap (centre + 4 neighbours) mean |a(x + d) - c(x + d + D)|. Accepted if
//      at most twice the rescue knob.
//   3. each orphan refines it for itself (+-2 flow px by the 5-tap cost, accepted by the 3x3 mean |a - c|: the block's
//      displacement keeps the object together, the
//      refinement follows its turning and scaling); if that cost is at most the knob and its match in curr is unused too (no pixel
//      of the 3x3 around x + D shown, bit 1), it votes for the half-vector D / 2 at its midpoint m = x + D / 2 (atomicMax of a key:
//      the better match wins, then the lower x; the result does not depend on the order) and stores it (per x: one writer).
// A covered strip (seen in prev only) has no copy in curr: nothing to find; content shown on either side is left alone. v2_merge.comp
// writes the winners into hE, v2_close.comp closes the holes of the rescued objects.
// Reads the coverage bits, field[fE], vT, luma; writes the keys and the vectors (v2_temporal.glsl v2ROff()).
#include "common.glsl"
#include "motion_v2.glsl"
#include "v2_temporal.glsl"
layout(local_size_x = 8, local_size_y = 8) in;

bool covered(ivec2 p, uint bit) {   // any pixel of the 3x3 around p shown (outside the frame: not shown)
    int cov = v2ROff();
    for (int j = 0; j < 9; j++) {
        ivec2 y = p + ivec2(j % 3 - 1, j / 3 - 1);
        if (any(lessThan(y, ivec2(0))) || any(greaterThanEqual(y, ivec2(pc.fw, pc.fh)))) continue;
        if ((v2b[cov + y.y * pc.fw + y.x] & bit) != 0u) return true;
    }
    return false;
}

// 5-tap mean |a(x + d) - c(x + d + D)| (integer taps); a match that leaves the frame costs 255
float cost5(ivec2 x, ivec2 D) {
    ivec2 xc = x + D;
    if (any(lessThan(xc, ivec2(1))) || any(greaterThanEqual(xc, ivec2(pc.fw - 1, pc.fh - 1)))) return 255.0;
    const ivec2 o[5] = ivec2[5](ivec2(0), ivec2(-1, 0), ivec2(1, 0), ivec2(0, -1), ivec2(0, 1));
    float s = 0.0;
    for (int j = 0; j < 5; j++)
        s += abs(L(pc.offA, x.x + o[j].x, x.y + o[j].y, pc.fw, pc.fh) - L(pc.offC, xc.x + o[j].x, xc.y + o[j].y, pc.fw, pc.fh));
    return s * 0.2;
}

// 3x3 mean |a(x + d) - c(x + d + D)| (integer taps); a match that leaves the frame costs 255
float cost9(ivec2 x, ivec2 D) {
    ivec2 xc = x + D;
    if (any(lessThan(xc, ivec2(1))) || any(greaterThanEqual(xc, ivec2(pc.fw - 1, pc.fh - 1)))) return 255.0;
    float s = 0.0;
    for (int j = 0; j < 9; j++) {
        ivec2 d = ivec2(j % 3 - 1, j / 3 - 1);
        s += abs(L(pc.offA, x.x + d.x, x.y + d.y, pc.fw, pc.fh) - L(pc.offC, xc.x + d.x, xc.y + d.y, pc.fw, pc.fh));
    }
    return s * (1.0 / 9.0);
}

const int NCAND = 7;
shared uint nOrph;
shared uint sums[9 * NCAND];
shared vec2 cand[NCAND];

void main() {
    int lid = int(gl_LocalInvocationIndex);
    ivec2 blk = ivec2(gl_WorkGroupID.xy);
    ivec2 x = ivec2(gl_GlobalInvocationID.xy);
    if (lid == 0) nOrph = 0u;
    barrier();
    bool orph = false;
    if (x.x < pc.fw && x.y < pc.fh && !covered(x, 1u)) {
        float lo = 1e9, hi = -1e9;
        for (int j = 0; j < 25; j++) {
            float v = L(pc.offA, x.x + j % 5 - 2, x.y + j / 5 - 2, pc.fw, pc.fh);
            lo = min(lo, v); hi = max(hi, v);
        }
        if (hi - lo >= 10.0) {
            vec2 h = field[pc.fE + x.y * pc.fw + x.x];
            float dif = 0.0;
            for (int j = 0; j < 9; j++) {
                vec2 y = vec2(x + ivec2(j % 3 - 1, j / 3 - 1));
                float o = 0.5 * (sampleL(pc.offA, y - h, pc.fw, pc.fh) + sampleL(pc.offC, y + h, pc.fw, pc.fh));
                dif += abs(L(pc.offA, int(y.x), int(y.y), pc.fw, pc.fh) - o);
            }
            orph = dif * (1.0 / 9.0) >= 12.0;
        }
    }
    if (orph) atomicAdd(nOrph, 1u);
    // the candidates (threads 0-6)
    ivec2 c0 = min(blk * 8 + 4, ivec2(pc.fw - 1, pc.fh - 1));
    if (lid < 5) {
        const ivec2 o[5] = ivec2[5](ivec2(0), ivec2(-12, 0), ivec2(12, 0), ivec2(0, -12), ivec2(0, 12));
        ivec2 y = clamp(c0 + o[lid], ivec2(0), ivec2(pc.fw - 1, pc.fh - 1));
        cand[lid] = field[pc.fE + y.y * pc.fw + y.x];
    } else if (lid == 5) {
        cand[5] = v2SeedValid() ? v2VT(c0) : field[pc.fE + c0.y * pc.fw + c0.x];   // (no valid seed: a duplicate of cand[0], read directly (lane 0 writes it before the barrier), skipped; the result is a fresh instance's)
    } else if (lid == 6) {
        cand[6] = vec2(uintBitsToFloat(u[4]), uintBitsToFloat(u[5]));
    }
    if (lid < 9 * NCAND) sums[lid] = 0u;
    barrier();
    uint n = nOrph;
    if (n < 8u) return;   // (uniform)
    // the block's displacement: each candidate's (2 x its vector, rounded) and +-3 around it, the sum over the orphans of cost5
    if (orph)
        for (int k = 0; k < NCAND; k++) {
            ivec2 D0 = ivec2(roundEven(2.0 * cand[k]));
            bool dup = false;   // (an earlier candidate with the same displacement: its sums are the same)
            for (int i = 0; i < k; i++) dup = dup || D0 == ivec2(roundEven(2.0 * cand[i]));
            if (dup) continue;
            for (int r = 0; r < 9; r++)
                atomicAdd(sums[k * 9 + r], uint(roundEven(cost5(x, D0 + 3 * ivec2(r % 3 - 1, r / 3 - 1)) * 16.0)));
        }
    barrier();
    if (!orph) return;
    uint bs = 0xFFFFFFFFu;
    ivec2 bD = ivec2(0);
    for (int k = 0; k < NCAND; k++)   // (every orphan finds the same: ties the first; a duplicate's sums stay 0 and are skipped)
        for (int r = 0; r < 9; r++) {
            bool dup = false;
            for (int i = 0; i < k; i++) dup = dup || ivec2(roundEven(2.0 * cand[k])) == ivec2(roundEven(2.0 * cand[i]));
            if (!dup && sums[k * 9 + r] < bs) {
                bs = sums[k * 9 + r];
                bD = ivec2(roundEven(2.0 * cand[k])) + 3 * ivec2(r % 3 - 1, r / 3 - 1);
            }
        }
    if (float(bs) * (1.0 / 16.0) / float(n) > 2.0 * pc.rescue) return;
    // each orphan's own match: +-2 around the block's displacement
    ivec2 D = bD;
    float c5 = 1e9;
    for (int r = 0; r < 25; r++) {
        ivec2 Dr = bD + ivec2(r % 5 - 2, r / 5 - 2);
        float c = cost5(x, Dr);
        if (c < c5) { c5 = c; D = Dr; }   // (ties: the first)
    }
    float best = cost9(x, D);
    if (best > pc.rescue || covered(x + D, 2u)) return;
    vec2 uh = 0.5 * vec2(D);
    ivec2 m = ivec2(floor(vec2(x) + uh + 0.5));   // (x + D / 2: integer or half-integer; halves round up)
    if (any(lessThan(m, ivec2(0))) || any(greaterThanEqual(m, ivec2(pc.fw, pc.fh)))) return;
    int src = x.y * pc.fw + x.x;
    uint q = uint(min(roundEven(best * 16.0), 511.0));
    uint key = ((511u - q) << 23) | (0x7FFFFFu - uint(src));
    int ro = v2ROff();
    v2b[ro + 2 * pc.fw * pc.fh + src] = packV(uh);
    atomicMax(v2b[ro + pc.fw * pc.fh + m.y * pc.fw + m.x], key);
    atomicAdd(u[V2_U_VOTES], 1u);
}
