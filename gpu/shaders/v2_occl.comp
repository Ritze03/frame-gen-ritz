#version 450
#extension GL_GOOGLE_include_directive : require
// V2, estimate (after the pixel field, flow res, midpoint grid): occlusion analysis of the symmetric field (D12) and the vectors of
// the occluded pixels (D16). Writes the occlusion map (motion_v2.glsl) for every flow pixel q.
//
// The field h is symmetric: midpoint content at q is a(q - h) and c(q + h). At a motion boundary with normal n between side vectors
// v- (at q - r n) and v+ (at q + r n), d = (v+ - v-) . n is the normal motion difference:
//   d < 0: the field CONVERGES. The side behind moves into the side ahead: the strip next to the boundary is being covered between a
//          and c, it is visible in prev only -> side a (prev).
//   d > 0: the field DIVERGES. The strip is being uncovered, visible in curr only -> side c (curr).
// (1D check: left object moving right, h = +k, static right side h = 0: d = 0 - k < 0, and the strip [x0, x0 + k] right of the
// midpoint edge x0 shows the static background in a, but the object in c (its edge is at x0 + k at c): covered, take a. Mirror for
// d > 0.) The occluded strip at the midpoint is |d| wide (flow units) and lies on the background's side of the edge.
// A forward/backward check cannot see this on a symmetric field (search.comp: both directions are one vector).
//
// Per q: the direction (4: x, y, both diagonals) and distance (reach x 1, 2, 4) with the largest |d|; the pixel is near a clean
// occlusion if |d| >= edgeMin (distinct vectors), the distance is at most |d| + reach (the pixel is in or next to the strip, not just
// somewhere within 4 reach of an edge), and both side vectors are confident (3x3 mean |a - c| at their own place, finest-level luma,
// <= confMax), and each side vector is steady (the field half a reach further out agrees with it). Then a 3x3 majority cleans the
// map (main()). Background = the side vector nearer the global median vector (the camera motion; u[4..5], medhist.comp of the finest
// level, the same units): which side of the edge the background is on cannot be told from one symmetric field (both hypotheses
// produce the same field and mismatch), so the dominant motion decides. Foreground = the other side vector.
// Unless the previous pair's field tells (D19, I10; valid seed only, v2_temporal.glsl): a motion boundary moves with the FOREGROUND,
// so the field near it now is the previous field shifted by one frame of the foreground's motion, C(y) ~ P(y - 2 vF). Both hypotheses
// (vp or vm is the foreground) are scored by sum |C(y) - P(y - 2 v)|_1 over 9 points y on the normal through q, spanning the side
// distance plus the boundary's possible shift; the wrong one misplaces the boundary by 2 (vp - vm) and mismatches the points in
// between. A clear winner (lower by at least 3/4 of |vp - vm|_1, i.e. about one mismatched point) decides; else the median rule.
// (An object moving across a static view: the median is the static background's, so the rule picks right; a pan following a moving
// object: the median is the object's, and the median rule picks the object as background - the case this fixes.)
// Also stores this estimate's edge-aware field for the next one (v2_temporal.glsl, P slot parity).
#include "common.glsl"
#include "motion_v2.glsl"
#include "v2_temporal.glsl"
layout(local_size_x = 16, local_size_y = 16) in;
const int TQ = 16, TR = TQ + 2;   // tile, tile + 1

vec2 Fq(ivec2 q) { return field[pc.pf + clamp(q.y, 0, pc.fh - 1) * pc.fw + clamp(q.x, 0, pc.fw - 1)]; }

// 3x3 mean |a(y - v) - c(y + v)| around x (finest-level luma, flow res): does v describe the content at x?
float sideCost(ivec2 x, vec2 v) {
    float s = 0.0;
    for (int dy = -1; dy <= 1; dy++)
        for (int dx = -1; dx <= 1; dx++) {
            vec2 y = vec2(x + ivec2(dx, dy));
            s += abs(sampleL(pc.offA, y - v, pc.fw, pc.fh) - sampleL(pc.offC, y + v, pc.fw, pc.fh));
        }
    return s * (1.0 / 9.0);
}

// The raw analysis of flow pixel q (before the 3x3 regularisation in main()).
uvec4 analyse(ivec2 q) {
    float best = 0.0;
    ivec2 bo = ivec2(0);
    for (int k = 0; k < 3; k++) {
        int r = pc.reach << k;
        int rd = (r * 181 + 128) >> 8;   // r / sqrt(2), rounded: the diagonal steps about as far
        ivec2 offs[4] = ivec2[4](ivec2(r, 0), ivec2(0, r), ivec2(rd, rd), ivec2(rd, -rd));
        for (int i = 0; i < 4; i++) {
            ivec2 o = offs[i];
            vec2 n = normalize(vec2(o));
            float d = dot(Fq(q + o) - Fq(q - o), n);
            if (abs(d) > abs(best)) { best = d; bo = o; }   // ties: the nearer distance (searched first)
        }
    }
    if (abs(best) < pc.edgeMin || length(vec2(bo)) > abs(best) + float(pc.reach)) return uvec4(0u);
    vec2 vp = Fq(q + bo), vm = Fq(q - bo);
    // a side is a region, not one noisy vector: the field half a reach further out agrees with it
    ivec2 ext = ivec2(roundEven(normalize(vec2(bo)) * max(1.0, 0.5 * float(pc.reach))));
    float tol = max(0.5, 0.25 * abs(best));
    if (distance(Fq(q + bo + ext), vp) > tol || distance(Fq(q - bo - ext), vm) > tol) return uvec4(0u);
    if (sideCost(q + bo, vp) > pc.confMax || sideCost(q - bo, vm) > pc.confMax) return uvec4(0u);
    vec2 med = vec2(uintBitsToFloat(u[4]), uintBitsToFloat(u[5]));
    bool pBg = distance(vp, med) <= distance(vm, med);
    {   // the previous field: which side's motion did the boundary follow? (measured whether the seed is valid or not: the same work)
        int old = 1 - (pc.tFlags & 1);
        vec2 n = normalize(vec2(bo));
        float span = length(vec2(bo)) + 2.0 * abs(best) + 1.0;
        float eP = 0.0, eM = 0.0;
        for (int k = -4; k <= 4; k++) {
            vec2 y = vec2(q) + roundEven(n * (span * float(k) * 0.25));
            vec2 c = Fq(ivec2(y));
            vec2 a = c - v2PAt(old, y - 2.0 * vp), b = c - v2PAt(old, y - 2.0 * vm);
            eP += abs(a.x) + abs(a.y);
            eM += abs(b.x) + abs(b.y);
        }
        vec2 dv = abs(vp - vm);
        float margin = 0.75 * (dv.x + dv.y);
        if (v2SeedValid() && abs(eP - eM) >= margin) pBg = eM < eP;   // vm's motion explains the boundary: vm is the foreground
    }
    vec2 vB = pBg ? vp : vm, vF = pBg ? vm : vp;
    return uvec4(packHalf2x16(vB), packHalf2x16(vF), best < 0.0 ? 1u : 2u, 0u);
}

shared uvec4 raw[TR * TR];   // the tile + 1

// Regularisation (3x3 majority): a flagged pixel with fewer than 3 flagged neighbours is dropped (an isolated decision is noise, and
// a lone warped pixel in a held patch is a speckle); an unflagged pixel with at least 5 flagged neighbours takes the side of their
// majority and the vectors of the first of them with that side (a hole in an occluded strip would be a held speck).
void main() {
    int lid = int(gl_LocalInvocationIndex);
    ivec2 t0 = ivec2(gl_WorkGroupID.xy) * TQ - 1;
    for (int i = lid; i < TR * TR; i += TQ * TQ) {
        ivec2 q = t0 + ivec2(i % TR, i / TR);
        raw[i] = (q.x >= 0 && q.y >= 0 && q.x < pc.fw && q.y < pc.fh) ? analyse(q) : uvec4(0u);
    }
    barrier();
    ivec2 l = ivec2(gl_LocalInvocationID.xy);
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    if (q.x >= pc.fw || q.y >= pc.fh) return;
    uvec4 res = raw[(l.y + 1) * TR + l.x + 1];
    int na = 0, nc = 0;
    for (int y = 0; y < 3; y++)
        for (int x = 0; x < 3; x++) {
            if (x == 1 && y == 1) continue;
            uint sd = raw[(l.y + y) * TR + l.x + x].z;
            na += sd == 1u ? 1 : 0;
            nc += sd == 2u ? 1 : 0;
        }
    if (res.z != 0u && na + nc < 3) res = uvec4(0u);
    else if (res.z == 0u && na + nc >= 5) {
        uint want = na >= nc ? 1u : 2u;
        for (int k = 0; k < 9; k++) {
            uvec4 r = raw[(l.y + k / 3) * TR + l.x + k % 3];
            if (r.z == want) { res = r; break; }
        }
    }
    int i = 4 * (q.y * pc.fw + q.x);
    v2b[i] = res.x; v2b[i + 1] = res.y; v2b[i + 2] = res.z; v2b[i + 3] = res.w;
    v2b[v2POff(pc.tFlags & 1) + q.y * pc.fw + q.x] = packV(Fq(q));   // the temporal store: this pair's field for the next estimate
}
