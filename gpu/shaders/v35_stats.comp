#version 450
#extension GL_GOOGLE_include_directive : require
// MotionVersion::V3.5 (Settings::v3Motion = 1): v3_stats.comp with every sample's weight multiplied by its block's texture (smoothstep(1, 3.5, mean detail of the block's features):
// a flat block matches at every vector with a low cost and used to outvote the textured blocks that carry the real motion of a dark, flat scene). Everything else is v3_stats.comp.
// MotionVersion::V3, build step E2 (gpu/V3.md section 3.7): the frame's dominant motions and the camera, from the block vectors of level LH (push: lvl = LH),
// both directions. One workgroup of 256 threads, one dispatch, no readback, integer atomics in shared memory only.
// Every sample is "prev position x -> displacement d to curr" in level-0 flow px: F01 block at its centre with d = v 2^LH, F10 block at curr position q with
// f: x = q + f 2^LH, d = -f 2^LH. Weight w = 1 - smoothstep(6, 18, cost).
// Phase A: a 32x32 histogram of d over [-R_H, R_H]^2 (R_H = 1.25 * 8 * 2^(n-1)); four times: argmax of the 3x3-smoothed counts, the mean of the samples of
// the 3x3 bins, two mean-shift steps over all samples (radius 1.5 / 0.75 of a level-LH px: 12 / 6 flow px at LH = 3), suppression of the 5x5 bins; the peak
// is valid if the weight within the first radius is >= max(8, 3% of the total).
// Phase B: the camera as a robust weighted least-squares affine model d(x) = (a0 + a1 X + a2 Y, b0 + b1 X + b2 Y), X = (x - c) / (fw/2), Y likewise with fh/2:
// Cramer's rule on two 3x3 normal systems, one re-weighting round w / (1 + (r / (1.5 2^LH))^2), valid if the inlier weight (r < 2 2^LH) is >= 40% of the total
// and the determinant is not tiny.
// Output (state G of V3B_AUX): dom[4], domValid bits 0..3, aff[6], affValid bit 8 of the same word, camTrans = (a0, b0).
#include "common.glsl"
#include "v3_common.glsl"
#include "v3_est.glsl"

layout(local_size_x = 256) in;

shared int smem[3072];      // phase A: cnt[1024] (weight x 16), sx[1024], sy[1024] (sum of weight x 16 x d); phase B: the float reduction area (12 x 256)
shared float part[192];
shared float res[12];
shared int msum[4];
shared uint pkey;
shared vec2 cen;
shared float mass;
shared int wtot;
shared int domOk;

int tid;
const int NC = 8;   // samples per thread kept in registers (the passes below walk them again and again)
vec4 cs[NC];          // (x, d) of this thread's samples tid + 256 j, j < NC; w in csw
float csw[NC];
V3Lv L;
int nSamp, nBlk, nLev, nFull, st;   // nFull all samples (2 per block), nSamp those used: every st-th, with a jitter within the stride (all stay in the registers, none is computed twice)
float sc;   // 2^LH

// sample i: x (prev position), d (displacement to curr), w (weight); level-0 flow px
void sampleAt(int is, out vec2 x, out vec2 d, out float w) {
    const int i = st == 1 ? is : min(is * st + int(((uint(is) * 2654435761u) >> 16) % uint(st)), nFull - 1);
    const int dir = i >= nBlk ? 1 : 0;
    const int b = dir == 1 ? i - nBlk : i;
    const ivec2 bi = ivec2(b % L.gw, b / L.gw);
    const int o = v3BlkIdx(L, dir, 1, bi);
    const vec3 r = vec3(fl[o], fl[o + 1], fl[o + 2]);
    const ivec2 x0 = bi * 4, x1 = min(x0 + 4, ivec2(L.w, L.h));
    const vec2 c = 0.5 * vec2(x0 + x1) * sc;
    const vec2 v = r.xy * sc;
    if (dir == 0) { x = c; d = v; }
    else { x = c + v; d = -v; }
    w = 1.0 - smoothstep(6.0, 18.0, r.z);
    if (w > 0.0) {   // the block's texture in the role-0 frame (4 x 4 samples of the block)
        int P, Bw, nl;
        v3Totals(P, Bw, nl);
        float en = 0.0, n = 0.0;
        for (int j = 0; j < 4; j++)
            for (int i = 0; i < 4; i++) {
                const ivec2 q = x0 + ivec2(i, j);
                if (q.x >= L.w || q.y >= L.h) continue;
                en += v3Detail(v3FeatAt(L, 2 * P, dir, q));
                n += 1.0;
            }
        w *= smoothstep(1.0, 3.5, en / max(n, 1.0));
    }
}

// sample j of this thread (index tid + 256 j): from the cache for j < NC; weight 0 beyond the last sample
void mySample(int j, out vec2 x, out vec2 d, out float w) {
    if (j < NC) { x = cs[j].xy; d = cs[j].zw; w = csw[j]; return; }
    const int i = tid + 256 * j;
    if (i >= nSamp) { x = d = vec2(0.0); w = 0.0; return; }
    sampleAt(i, x, d, w);
}

// the sums of 12 values per thread over the 256 threads (the result in every thread); smem holds the products
void red12(inout float a[12]) {
    for (int k = 0; k < 12; k++) smem[k * 256 + tid] = floatBitsToInt(a[k]);
    barrier();
    if (tid < 192) {
        const int v = tid >> 4, j = tid & 15;
        float s = 0.0;
        for (int i = 0; i < 16; i++) s += intBitsToFloat(smem[v * 256 + j * 16 + i]);
        part[tid] = s;
    }
    barrier();
    if (tid < 12) {
        float s = 0.0;
        for (int j = 0; j < 16; j++) s += part[tid * 16 + j];
        res[tid] = s;
    }
    barrier();
    for (int k = 0; k < 12; k++) a[k] = res[k];
}

// the solution of the 3x3 system M p = r (Cramer's rule; M symmetric: m = (m00, m01, m02, m11, m12, m22)); det out
vec3 solve3(float m[6], vec3 r, out float det) {
    const mat3 M = mat3(m[0], m[1], m[2], m[1], m[3], m[4], m[2], m[4], m[5]);
    det = determinant(M);
    const float id = 1.0 / (abs(det) > 1e-20 ? det : 1e-20);
    return vec3(determinant(mat3(r, M[1], M[2])), determinant(mat3(M[0], r, M[2])), determinant(mat3(M[0], M[1], r))) * id;
}

// the weighted normal equations over all samples: weights w / (1 + (r / (k sc))^2) with r the residual of aff (k = 3 for the first round, whose model is the
// first dominant motion as a pure translation, 1.5 for the second); pass 2 instead: a[0] = sum of the weights w of the inliers (r < 2 sc), a[1] = sum of w.
// a[0..5] the matrix, a[6..8] the right-hand side of dx, a[9..11] of dy.
void accumulate(int pass, const float aff[6], out float a[12]) {
    for (int k = 0; k < 12; k++) a[k] = 0.0;
    for (int j = 0; tid + 256 * j < nSamp; j++) {
        vec2 x, d;
        float w;
        mySample(j, x, d, w);
        if (w <= 0.0) continue;
        const vec2 XY = (x - vec2(pc.cx, pc.cy)) / vec2(pc.cx, pc.cy);
        const vec2 m = vec2(aff[0] + aff[1] * XY.x + aff[2] * XY.y, aff[3] + aff[4] * XY.x + aff[5] * XY.y);
        const float r = length(d - m);
        if (pass == 2) { a[0] += r < 2.0 * sc ? w : 0.0; a[1] += w; continue; }
        const float q = r / ((pass == 0 ? 3.0 : 1.5) * sc);
        w /= 1.0 + q * q;
        a[0] += w; a[1] += w * XY.x; a[2] += w * XY.y;
        a[3] += w * XY.x * XY.x; a[4] += w * XY.x * XY.y; a[5] += w * XY.y * XY.y;
        a[6] += w * d.x; a[7] += w * XY.x * d.x; a[8] += w * XY.y * d.x;
        a[9] += w * d.y; a[10] += w * XY.x * d.y; a[11] += w * XY.y * d.y;
    }
}

// one mean-shift step: the weighted mean of the samples within radius r of c; the result in cen, its mass in mass (all threads, synchronised on return)
void meanShift(vec2 c, float r) {
    if (tid < 4) msum[tid] = 0;
    barrier();
    float sx = 0.0, sy = 0.0, sw = 0.0;
    for (int j = 0; tid + 256 * j < nSamp; j++) {
        vec2 x, d;
        float w;
        mySample(j, x, d, w);
        if (w > 0.0 && length(d - c) < r) { sx += w * d.x; sy += w * d.y; sw += w; }
    }
    atomicAdd(msum[0], int(round(sx * 16.0)));
    atomicAdd(msum[1], int(round(sy * 16.0)));
    atomicAdd(msum[2], int(round(sw * 16.0)));
    barrier();
    if (tid == 0) {
        mass = float(msum[2]) * (1.0 / 16.0);
        cen = msum[2] > 0 ? vec2(float(msum[0]), float(msum[1])) / float(msum[2]) : c;
    }
    barrier();
}

void main() {
    tid = int(gl_LocalInvocationIndex);
    const int lh = pc.lvl;
    L = v3Lv(lh);
    int P, Bw;
    v3Totals(P, Bw, nLev);
    nBlk = L.gw * L.gh;
    nFull = 2 * nBlk;
    st = max(1, (nFull + NC * 256 - 1) / (NC * 256));
    nSamp = (nFull + st - 1) / st;
    sc = float(1 << lh);
    const float RH = 1.25 * 8.0 * float(1 << (nLev - 1));
    const int g = gOff();

    // ---- phase A: the histogram
    for (int i = tid; i < 3072; i += 256) smem[i] = 0;
    if (tid == 0) { wtot = 0; domOk = 0; }
    barrier();
    for (int j = 0; j < NC; j++) { cs[j] = vec4(0.0); csw[j] = 0.0; }
    for (int j = 0; tid + 256 * j < nSamp; j++) {
        vec2 x, d;
        float w;
        sampleAt(tid + 256 * j, x, d, w);
        if (j < NC) { cs[j] = vec4(x, d); csw[j] = w; }
        const int w16 = int(w * 16.0 + 0.5);
        if (w16 <= 0) continue;
        const ivec2 bn = clamp(ivec2(floor((d + RH) * (16.0 / RH))), ivec2(0), ivec2(31));
        const int b = bn.y * 32 + bn.x;
        atomicAdd(smem[b], w16);
        atomicAdd(smem[1024 + b], int(round(float(w16) * d.x)));
        atomicAdd(smem[2048 + b], int(round(float(w16) * d.y)));
        atomicAdd(wtot, w16);
    }
    barrier();
    const float wAll = float(wtot) * (1.0 / 16.0);
    const float minMass = max(8.0, 0.015 * wAll);
    vec2 dom[4];
    for (int k = 0; k < 4; k++) dom[k] = vec2(0.0);
    for (int k = 0; k < 4; k++) {
        if (tid == 0) pkey = 0u;
        barrier();
        for (int b = tid; b < 1024; b += 256) {
            const ivec2 bn = ivec2(b & 31, b >> 5);
            int s = 0;
            for (int j = -1; j <= 1; j++)
                for (int i = -1; i <= 1; i++) {
                    const ivec2 q = bn + ivec2(i, j);
                    if (all(greaterThanEqual(q, ivec2(0))) && all(lessThan(q, ivec2(32)))) s += smem[q.y * 32 + q.x];
                }
            if (s > 0) atomicMax(pkey, (uint(s) << 10) | uint(1023 - b));
        }
        barrier();
        if (pkey == 0u) break;   // no peak left (uniform)
        const int pb = 1023 - int(pkey & 1023u);
        const ivec2 pbn = ivec2(pb & 31, pb >> 5);
        if (tid == 0) {   // the mean of the samples of the 3x3 bins around the peak
            float cx = 0.0, cy = 0.0, cw = 0.0;
            for (int j = -1; j <= 1; j++)
                for (int i = -1; i <= 1; i++) {
                    const ivec2 q = pbn + ivec2(i, j);
                    if (all(greaterThanEqual(q, ivec2(0))) && all(lessThan(q, ivec2(32)))) {
                        cx += float(smem[1024 + q.y * 32 + q.x]); cy += float(smem[2048 + q.y * 32 + q.x]); cw += float(smem[q.y * 32 + q.x]);
                    }
                }
            cen = cw > 0.0 ? vec2(cx, cy) / cw : vec2(0.0);
        }
        barrier();
        meanShift(cen, 1.5 * sc);
        const float m1 = mass;
        meanShift(cen, 0.75 * sc);
        dom[k] = cen;
        if (m1 >= minMass && tid == 0) domOk |= 1 << k;
        // suppress the 5x5 bins around the peak
        if (tid < 25) {
            const ivec2 q = pbn + ivec2(tid % 5 - 2, tid / 5 - 2);
            if (all(greaterThanEqual(q, ivec2(0))) && all(lessThan(q, ivec2(32)))) {
                const int b = q.y * 32 + q.x;
                smem[b] = 0; smem[1024 + b] = 0; smem[2048 + b] = 0;
            }
        }
        barrier();
    }
    barrier();   // (the histogram is dead: its memory is the reduction area from here)

    // ---- phase B: the camera
    float aff[6] = float[6](dom[0].x, 0.0, 0.0, dom[0].y, 0.0, 0.0);   // (the first dominant motion, zero when there is none)
    float a[12];
    float det = 0.0, sw0 = 0.0;
    for (int pass = 0; pass < 2; pass++) {
        accumulate(pass, aff, a);
        red12(a);
        sw0 = a[0];
        const float reg = 1e-3 * a[0];
        float m[6] = float[6](a[0] + reg, a[1], a[2], a[3] + reg, a[4], a[5] + reg);
        const vec3 px = solve3(m, vec3(a[6], a[7], a[8]), det), py = solve3(m, vec3(a[9], a[10], a[11]), det);
        aff = float[6](px.x, px.y, px.z, py.x, py.y, py.z);
    }
    accumulate(2, aff, a);
    red12(a);
    // (task 109) a model that is not finite or moves some part of the frame by more than the frame's size is no model ("finite or zeroed" by the tests
    // above already; this makes it explicit and also catches an absurd finite one): |a0| + |a1| + |a2| bounds the x motion over the frame (|X|, |Y| <= 1)
    const float lim = 2.0 * max(pc.cx, pc.cy);   // the flow frame's larger side (cx, cy = fw / 2, fh / 2)
    const bool affSane = abs(aff[0]) + abs(aff[1]) + abs(aff[2]) < lim && abs(aff[3]) + abs(aff[4]) + abs(aff[5]) < lim;   // (false for NaN / inf)
    const bool affOk = a[0] >= 0.4 * a[1] && a[1] >= 8.0 && abs(det) > 1e-4 * sw0 * sw0 * sw0 && affSane;   // (the weight of the last round)

    if (tid == 0) {
        uint valid = uint(domOk);
        for (int k = 0; k < 4; k++)   // (task 109) likewise a dominant motion: not finite or beyond the frame is no peak
            if (!(abs(dom[k].x) < lim && abs(dom[k].y) < lim)) valid &= ~(1u << k);
        for (int k = 0; k < 4; k++) {
            ax[g + G_DOM + 2 * k] = floatBitsToUint(dom[k].x);
            ax[g + G_DOM + 2 * k + 1] = floatBitsToUint(dom[k].y);
        }
        for (int k = 0; k < 6; k++) ax[g + G_AFF + k] = floatBitsToUint(affOk ? aff[k] : 0.0);
        if (affOk) valid |= 256u;
        ax[g + G_VALID] = valid;
        ax[g + G_CAM_TRANS] = floatBitsToUint(aff[0]);
        ax[g + G_CAM_TRANS + 1] = floatBitsToUint(aff[3]);
    }
}
