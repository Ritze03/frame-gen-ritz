#version 450
#extension GL_GOOGLE_include_directive : require
// Global decisions: mean finest-level SAD > CUT_SAD (scene cut) or untrusted share > GLOBAL_FRAC
// -> present the nearer real frame (a for t <= 0.5, c after). Every workgroup exits immediately in the normal case.
#include "common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;

void main() {
    float meanSad = float(u[U_SADSUM]) * (1.0 / 256.0) / float(pc.bw * pc.bh);
    bool cut = meanSad > CUT_SAD;
    bool flick = float(u[U_UNTRUSTED]) > GLOBAL_FRAC * float(pc.W) * float(pc.H);
    if (!cut && !flick) return;
    // one 8x8 workgroup per 64x64 tile, so the common no-op case launches few workgroups
    for (int j = 0; j < 8; j++)
        for (int i = 0; i < 8; i++) {
            ivec2 p = ivec2(gl_WorkGroupID.xy) * 64 + ivec2(i, j) * 8 + ivec2(gl_LocalInvocationID.xy);
            if (p.x < pc.W && p.y < pc.H) imageStore(outImg, p, NEAR_C ? texelFetch(texCurr, p, 0) : texelFetch(texPrev, p, 0));
#ifdef FG_YUV
            if (p.x < pc.W && p.y < pc.H && ((p.x | p.y) & 1) == 0)   // the chroma texel of the even-even pixel of each block
                imageStore(outImgC, p >> 1, NEAR_C ? texelFetch(texCurrC, p >> 1, 0) : texelFetch(texPrevC, p >> 1, 0));
#endif
        }
}
