#version 450
#extension GL_GOOGLE_include_directive : require
// V2 Quality, the per-pixel field (flow resolution, once per estimate): the cleaned block field upsampled with edge awareness. Each
// flow pixel blends the 4 block vectors around it (the bilinear corners) with weights (bilinear + Q_FB) * exp(-(e_k - e_min) / Q_FS),
// e_k the mean |luma_a(m + o - v_k) - luma_c(m + o + v_k)| over a 3x3 neighbourhood: inside an object its own vector wins against the
// background's, so the motion edge follows the object (the plain bilinear blend ramps over a whole block). Soft weights, no hard
// choice: where no candidate matches clearly (occlusion, flat areas) the blend stays near bilinear and content stretches instead of
// tearing. Where the 4 vectors agree (within Q_FSAME) the bilinear blend is taken as is. Writes vf[qPF + m] (v2_quality.glsl).
#include "common.glsl"
#include "v2_motion.glsl"
#include "v2_quality.glsl"
layout(local_size_x = 8, local_size_y = 8) in;

float err(vec2 m, vec2 v) {
    float e = 0.0;
    float g = pc.t[12];   // centre weight (1 = box)
    for (int j = -1; j <= 1; j++)
        for (int i = -1; i <= 1; i++) {
            vec2 p = m + vec2(i, j);
            float w = (i == 0 && j == 0) ? g : 1.0;
            e += w * abs(qLuma(0, p - v) - qLuma(qN(), p + v));
        }
    return e / (8.0 + g);
}

// the zero vector's error, mean-removed over the 3x3 (a static overlay whose semi-transparent parts follow the brightness of the scene
// behind it still matches)
float err0(ivec2 m) {
    float a[9], c[9];
    float ma = 0.0, mc = 0.0;
    for (int k = 0; k < 9; k++) {
        ivec2 p = m + ivec2(k % 3 - 1, k / 3 - 1);
        a[k] = qL(0, p); c[k] = qL(qN(), p);
        ma += a[k]; mc += c[k];
    }
    float d = (ma - mc) * (1.0 / 9.0), e = 0.0;
    for (int k = 0; k < 9; k++) e += (k == 4 ? pc.t[12] : 1.0) * abs(a[k] - c[k] - d);
    return e / (8.0 + pc.t[12]);
}

void main() {
    ivec2 m = ivec2(gl_GlobalInvocationID.xy);
    if (m.x >= pc.fw || m.y >= pc.fh) return;
    vec2 s = (vec2(m) + 0.5) * (1.0 / float(V2_BLOCK)) - 0.5;
    vec2 fl = floor(s);
    vec2 f = s - fl;
    ivec2 i = ivec2(fl);
    vec2 v[4] = vec2[4](VF(i), VF(i + ivec2(1, 0)), VF(i + ivec2(0, 1)), VF(i + ivec2(1, 1)));
    float b[4] = float[4]((1.0 - f.x) * (1.0 - f.y), f.x * (1.0 - f.y), (1.0 - f.x) * f.y, f.x * f.y);
    vec2 lo = min(min(v[0], v[1]), min(v[2], v[3])), hi = max(max(v[0], v[1]), max(v[2], v[3]));
    vec2 h = b[0] * v[0] + b[1] * v[1] + b[2] * v[2] + b[3] * v[3];
    bool moving = max(max(abs(lo.x), abs(hi.x)), max(abs(lo.y), abs(hi.y))) > 1.0;
    bool zc = false;   // the zero vector is a candidate: where the field moves and the pixel has structure (HUD, subtitle text)
    float e0 = 0.0, con = 1.0;
    if (pc.t[9] > 0.5 && moving) {
        float mn = 1e9, mx = -1e9;
        for (int j = -1; j <= 1; j++)
            for (int i2 = -1; i2 <= 1; i2++) { float l = qL(0, m + ivec2(i2, j)); mn = min(mn, l); mx = max(mx, l); }
        if (mx - mn >= pc.t[11]) { zc = true; e0 = err0(m); con = mx - mn; }
    }
    bool soft0 = zc && pc.t[9] < 1.5;   // QZ=1: the zero vector in the soft blend
    float emot = 0.0;
    if (soft0 || (pc.t[6] > 0.5 && max(hi.x - lo.x, hi.y - lo.y) > Q_FSAME)) {
        float e[4];
        float emin = soft0 ? e0 : 1e9, em2 = 1e9;
        for (int k = 0; k < 4; k++) { e[k] = err(vec2(m), v[k]); emin = min(emin, e[k]); em2 = min(em2, e[k]); }
        vec2 acc = vec2(0.0);
        float ws = 0.0;
        for (int k = 0; k < 4; k++) {
            float w = (b[k] + pc.t[8]) * exp(-(e[k] - emin) / pc.t[7]);
            acc += w * v[k];
            ws += w;
        }
        if (soft0) ws += (1.0 + pc.t[8]) * exp(-(e0 - emin) / pc.t[7]);   // (+ 0 * its weight)
        h = acc / ws;
        emot = em2;
    } else if (zc) {
        emot = err(vec2(m), h);
    }
    // the static-overlay mask (v2_qcov packs it with the coverage, the gather shows the real frames' pixels there): how clearly the
    // zero vector beats the motion
    // zero vector beats the motion: a static overlay is in front of whatever moves behind it, so it only has to match (relative to
    // its contrast: compression noise grows with it), not to match better than the motion
    float z = zc ? clamp((pc.t[14] - e0 / con) * (1.0 / (pc.t[14] - pc.t[13])), 0.0, 1.0) : 0.0;
    if (zc && pc.t[9] > 1.5 && z >= 0.5) h = vec2(0.0);   // QZ=2: a hard switch
    vf[qPF() + m.y * pc.fw + m.x] = h;
    qb[3 * qN() + m.y * pc.fw + m.x] = floatBitsToUint(z);
}