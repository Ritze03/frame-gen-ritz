#version 450
#extension GL_GOOGLE_include_directive : require
// Passes 3+4 fused, one workgroup per 8x8 block: pick the seed among 6 candidates (own parent, 3 nearest
// other parents, zero, global median; LAMBDA penalty on all but own), then integer search +-radius
// around it, cost = SAD + LAMBDA*|step|_1. Coarsest level (medIdx < 0): seed = 0.
// Bilateral: a sampled at q - v, c at q + v. All vectors here are integers -> exact texel taps.
// sadAcc (finest level with sub-pixel refinement off): also adds the winning SAD to the scene-cut sum.
#include "common.glsl"
#include "motion_v1.glsl"
layout(local_size_x = 64) in;
#include "search_core.glsl"
