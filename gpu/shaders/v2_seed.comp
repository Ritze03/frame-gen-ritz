#version 450
#extension GL_GOOGLE_include_directive : require
// V2, estimate (flow res, after the pyramid, before the search; D19): prepares the previous pair's field for this estimate
// (v2_temporal.glsl).
//   1. vT(q), the previous edge-aware field P motion-compensated to this pair's midpoint. P lives on the previous pair's midpoint
//      grid, one real frame earlier: content at q now was at q - 2 v then (v = the half-vector, a frame of motion = 2 v), so
//      vT(q) = P(q - 2 vT(q)), 2 fixed-point steps from P(q) with nearest taps (a candidate vector must be one of P's, not a blend
//      of two motions at an edge). Written for every q, whether the seed is valid or not (the work does not depend on the data).
//   2. Is this pair the continuation of the last one (its prev = the last estimate's curr)? The coarsest pyramid level of prev is
//      compared with the stored coarsest level of the last estimate's curr: the mean |difference| x 2^20 goes to u[V2_U_SEED],
//      + 2^31 if the host says there is no previous estimate (tFlags bit 1 clear: after init / resize / reconfigure / a switch of
//      the motion version, or Settings::v2Temporal off). The same real frame gives exactly 0; a skipped frame, an out-of-order
//      or repeated pair, or a scene cut between the pairs does not, and the seed is dropped (v2SeedValid()). Then this pair's curr
//      level is stored for the next estimate (ping-pong slot, so the comparison and the store never overlap).
// Reads luma[offA / offC] (the coarsest level, lw x lh), v2b[] P slot 1 - parity and the stored level slot 1 - parity; writes vT,
// the level slot parity and u[V2_U_SEED].
#include "common.glsl"
#include "motion_v2.glsl"
#include "v2_temporal.glsl"
layout(local_size_x = 16, local_size_y = 16) in;

shared uint acc;

void main() {
    int lid = int(gl_LocalInvocationIndex);
    if (lid == 0) acc = 0u;
    barrier();
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    int par = pc.tFlags & 1;
    bool hostOk = (pc.tFlags & 2) != 0;
    if (q.x < pc.fw && q.y < pc.fh) {
        vec2 v = v2PAt(1 - par, vec2(q));
        for (int k = 0; k < 2; k++) v = v2PAt(1 - par, vec2(q) - 2.0 * v);
        v2b[v2VTOff() + q.y * pc.fw + q.x] = packV(v);
    }
    int n = pc.lw * pc.lh;
    if (q.x < pc.lw && q.y < pc.lh) {
        int i = q.y * pc.lw + q.x;
        if (hostOk) {
            float d = abs(luma[pc.offA + i] - uintBitsToFloat(v2b[v2LOff(1 - par, n) + i]));
            d = d <= 255.0 ? d : 255.0;   // (also a NaN of a never-written slot)
            atomicAdd(acc, uint(roundEven(d * (1048576.0 / float(n)))));
        }
        v2b[v2LOff(par, n) + i] = floatBitsToUint(luma[pc.offC + i]);
    }
    barrier();
    if (lid == 0) {
        uint a = acc;
        if (!hostOk && gl_WorkGroupID.x == 0u && gl_WorkGroupID.y == 0u) a += 0x80000000u;
        if (a != 0u) atomicAdd(u[V2_U_SEED], a);
    }
}
