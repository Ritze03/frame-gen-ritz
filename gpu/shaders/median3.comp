#version 450
#extension GL_GOOGLE_include_directive : require
// Pass 5: per-component 3x3 median of the block field, replicate border (cv2.medianBlur ksize 3).
#include "common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;

float med9(float v[9]) {
    // partial selection: sort ascending enough to get element 4
    for (int i = 0; i <= 4; i++)
        for (int j = i + 1; j < 9; j++)
            if (v[j] < v[i]) { float t = v[i]; v[i] = v[j]; v[j] = t; }
    return v[4];
}

void main() {
    ivec2 b = ivec2(gl_GlobalInvocationID.xy);
    if (b.x >= pc.bw || b.y >= pc.bh) return;
    float xs[9], ys[9];
    int k = 0;
    for (int j = -1; j <= 1; j++)
        for (int i = -1; i <= 1; i++) {
            ivec2 c = clamp(b + ivec2(i, j), ivec2(0), ivec2(pc.bw - 1, pc.bh - 1));
            vec2 v = field[pc.fIn + c.y * pc.bw + c.x];
            xs[k] = v.x; ys[k] = v.y; k++;
        }
    field[pc.fOut + b.y * pc.bw + b.x] = vec2(med9(xs), med9(ys));
}
