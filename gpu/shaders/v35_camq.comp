#version 450
#extension GL_GOOGLE_include_directive : require
// MotionVersion::V3, Settings::v3Motion = 1 (V3.5): how well the camera model of v3_stats.comp explains the block field of the stats level (push: lvl, iter = the record slot):
// the share of the matching blocks (weight 1 - smoothstep(6, 18, cost), both directions) whose vector is within 1 level px of the model's. One workgroup, one dispatch;
// writes the share to word G35_CAMQ of the state. A global fit that most blocks disagree with (parallax, a repeating texture) is no help to a flat block and gets no vote.
#include "common.glsl"
#include "v3_common.glsl"
#include "v3_est.glsl"
#include "v35_cam.glsl"
layout(local_size_x = 256) in;
shared float sa[256], sb[256];
void main() {
    const int tid = int(gl_LocalInvocationIndex);
    const int l = pc.lvl;
    const V3Lv L = v3Lv(l);
    const int nb = L.gw * L.gh;
    float all_ = 0.0, ok = 0.0;
    for (int dir = 0; dir < 2; dir++)
        for (int i = tid; i < nb; i += 256) {
            const ivec2 b = ivec2(i % L.gw, i / L.gw);
            const int o = v3BlkIdx(L, dir, pc.iter, b);
            const vec3 r = vec3(fl[o], fl[o + 1], fl[o + 2]);
            const float w = 1.0 - smoothstep(6.0, 18.0, r.z);
            vec2 cv;
            if (w <= 0.0 || !camVote(L, l, dir, b, cv)) continue;
            all_ += w;
            ok += length(r.xy - cv) <= 1.0 ? w : 0.0;
        }
    sa[tid] = all_; sb[tid] = ok;
    barrier();
    for (int s = 128; s > 0; s >>= 1) {
        if (tid < s) { sa[tid] += sa[tid + s]; sb[tid] += sb[tid + s]; }
        barrier();
    }
    if (tid == 0) ax[gOff() + G35_CAMQ] = floatBitsToUint(sa[0] > 0.0 ? sb[0] / sa[0] : 0.0);
}
