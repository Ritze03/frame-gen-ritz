#version 450
#extension GL_GOOGLE_include_directive : require
// MotionVersion::V3, Settings::v3Motion = 1 (V3.5, round 2): regional camera models. The frame is cut into 4 x 3 regions; per region (its cell plus half a cell on every side,
// so neighbours overlap by half) an affine motion d(x) = (a0 + a1 X + a2 Y, b0 + b1 X + b2 Y), X = (x - c) / c_x, Y likewise, is fitted by weighted least squares from the F01
// blocks of level pc.lvl (slot pc.iter), in level-0 flow px. A sample counts by its match (1 - smoothstep(6, 18, cost)), by its texture (smoothstep(1, 3.5, mean detail)) and by the
// smaller eigenvalue of its structure tensor (an edge proves the motion across it only, so it counts little: smoothstep(0.1, 0.5, sqrt(l2))); a second round reweights by the
// residual (w / (1 + (r / (1.5 2^lvl))^2)). The parameters are pulled to the global camera model's (ridge, 60 sample weights); a region with too little weight takes the global model whole (valid bit 0
// clear). One workgroup of 256 threads per region (12), written to the state G words G35_REG + 8 r: a0 a1 a2 b0 b1 b2, weight sum, valid.
#include "common.glsl"
#include "v3_common.glsl"
#include "v3_est.glsl"
#include "v35_cam.glsl"
layout(local_size_x = 256) in;

shared float smem[12 * 256];
shared float part[192];
shared float rsum[12];

int tid;

void red12(inout float a[12]) {
    for (int k = 0; k < 12; k++) smem[k * 256 + tid] = a[k];
    barrier();
    if (tid < 192) {
        const int v = tid >> 4, j = tid & 15;
        float s = 0.0;
        for (int i = 0; i < 16; i++) s += smem[v * 256 + j * 16 + i];
        part[tid] = s;
    }
    barrier();
    if (tid < 12) {
        float s = 0.0;
        for (int j = 0; j < 16; j++) s += part[tid * 16 + j];
        rsum[tid] = s;
    }
    barrier();
    for (int k = 0; k < 12; k++) a[k] = rsum[k];
}

vec3 solve3(float m[6], vec3 r, out float det) {
    const mat3 M = mat3(m[0], m[1], m[2], m[1], m[3], m[4], m[2], m[4], m[5]);
    det = determinant(M);
    const float id = 1.0 / (abs(det) > 1e-20 ? det : 1e-20);
    return vec3(determinant(mat3(r, M[1], M[2])), determinant(mat3(M[0], r, M[2])), determinant(mat3(M[0], M[1], r))) * id;
}

V3Lv L;
int fOff;
float sc;
vec2 cc;
vec4 featAt(int f, ivec2 p) { return v3FeatC(L, fOff, f, p); }

// block b of F01: position x (level-0 flow px), d, weight
void sampleAt(ivec2 b, out vec2 x, out vec2 d, out float w) {
    const int o = v3BlkIdx(L, 0, pc.iter, b);
    const vec3 r = vec3(fl[o], fl[o + 1], fl[o + 2]);
    const ivec2 x0 = b * 4, x1 = min(x0 + 4, ivec2(L.w, L.h));
    x = 0.5 * vec2(x0 + x1) * sc;
    d = r.xy * sc;
    w = 1.0 - smoothstep(6.0, 18.0, r.z);
    if (w <= 0.0) return;
    float en = 0.0, n = 0.0, gxx = 0.0, gxy = 0.0, gyy = 0.0;
    for (int j = 0; j < 4; j++)
        for (int i = 0; i < 4; i++) {
            const ivec2 q = x0 + ivec2(i, j);
            if (q.x >= L.w || q.y >= L.h) continue;
            const vec4 f0 = featAt(0, q);
            en += v3Detail(f0);
            const vec4 dx = featAt(0, q + ivec2(1, 0)) - featAt(0, q - ivec2(1, 0));
            const vec4 dy = featAt(0, q + ivec2(0, 1)) - featAt(0, q - ivec2(0, 1));
            const vec3 w3 = V3_CW.xyz;
            gxx += dot(w3 * dx.xyz, dx.xyz); gxy += dot(w3 * dx.xyz, dy.xyz); gyy += dot(w3 * dy.xyz, dy.xyz);
            n += 1.0;
        }
    en /= max(n, 1.0);
    const float inv = 0.25 / max(n, 1.0);
    gxx *= inv; gxy *= inv; gyy *= inv;
    const float tr = gxx + gyy, df = sqrt(max(0.25 * (gxx - gyy) * (gxx - gyy) + gxy * gxy, 0.0));
    const float l2 = max(0.5 * tr - df, 0.0);
    w *= smoothstep(1.0, 3.5, en) * smoothstep(0.1, 0.5, sqrt(l2));
}

void main() {
    tid = int(gl_LocalInvocationIndex);
    const int reg = int(gl_WorkGroupID.x);
    L = v3Lv(pc.lvl);
    int P, Bw, nLev;
    v3Totals(P, Bw, nLev);
    fOff = 2 * P;
    sc = float(1 << pc.lvl);
    cc = vec2(pc.cx, pc.cy);
    const int g = gOff();
    const bool gv = (ax[g + G_VALID] & 256u) != 0u;
    vec3 ga = vec3(0.0), gb = vec3(0.0);
    if (gv) {
        ga = vec3(uintBitsToFloat(ax[g + G_AFF]), uintBitsToFloat(ax[g + G_AFF + 1]), uintBitsToFloat(ax[g + G_AFF + 2]));
        gb = vec3(uintBitsToFloat(ax[g + G_AFF + 3]), uintBitsToFloat(ax[g + G_AFF + 4]), uintBitsToFloat(ax[g + G_AFF + 5]));
    }
    // the region's window in level-0 flow px: cell (rx, ry) of 4 x 3 with half a cell on every side
    const int rx = reg % 4, ry = reg / 4;
    const vec2 cell = 2.0 * cc / vec2(4.0, 3.0);
    const vec2 w0 = (vec2(rx, ry) - 0.5) * cell, w1 = (vec2(rx, ry) + 1.5) * cell;
    // blocks of the level whose centre is in the window
    const ivec2 b0 = max(ivec2(floor(w0 / (4.0 * sc))), ivec2(0)), b1 = min(ivec2(ceil(w1 / (4.0 * sc))), ivec2(L.gw, L.gh));
    const ivec2 nb = max(b1 - b0, ivec2(0));
    const int nTot = nb.x * nb.y;
    const float ridge = 60.0;   // weight of the pull of the slopes to the global model (in units of summed sample weight)
    // the samples of this thread (index tid + 256 j, j < NC) are computed once and kept in registers; a window with more than 256 NC blocks is thinned (every step-th)
    const int NC = 12;
    const int step = max(1, (nTot + 256 * NC - 1) / (256 * NC));
    const int nUse = (nTot + step - 1) / step;
    vec4 cs[NC];
    float cw[NC];
    for (int j = 0; j < NC; j++) {
        cs[j] = vec4(0.0); cw[j] = 0.0;
        const int i = tid + 256 * j;
        if (i >= nUse) continue;
        const int ib = i * step;
        const ivec2 b = b0 + ivec2(ib % nb.x, ib / nb.x);
        vec2 x, d;
        float w;
        sampleAt(b, x, d, w);
        cs[j] = vec4(x, d); cw[j] = w;
    }
    vec3 pa = ga, pb = gb;
    float wsum = 0.0;
    for (int pass = 0; pass < 3; pass++) {
        float a[12];
        for (int k = 0; k < 12; k++) a[k] = 0.0;
        for (int j = 0; j < NC; j++) {
            const vec2 x = cs[j].xy, d = cs[j].zw;
            float w = cw[j];
            if (w <= 0.0) continue;
            const vec2 q = (x - cc) / cc;
            if (pass >= 1 || gv) {   // robust from the start: pass 0 weighs by the residual to the global model (the still foreground of a region is no inlier of the background)
                const vec2 m = vec2(dot(pa, vec3(1.0, q)), dot(pb, vec3(1.0, q)));
                const float r = length(d - m) / (1.5 * sc);
                w /= 1.0 + r * r;
            }
            const vec3 p = vec3(1.0, q);
            a[0] += w; a[1] += w * p.y; a[2] += w * p.z; a[3] += w * p.y * p.y; a[4] += w * p.y * p.z; a[5] += w * p.z * p.z;
            a[6] += w * d.x; a[7] += w * p.y * d.x; a[8] += w * p.z * d.x;
            a[9] += w * d.y; a[10] += w * p.y * d.y; a[11] += w * p.z * d.y;
        }
        red12(a);
        wsum = a[0];
        // ridge on the slopes towards the global slopes (lambda in sample weights)
        const float lam = gv ? ridge / float(step) : 0.0;
        float m[6] = float[6](a[0] + lam, a[1], a[2], a[3] + lam, a[4], a[5] + lam);
        float det;
        const vec3 sx = solve3(m, vec3(a[6] + lam * ga.x, a[7] + lam * ga.y, a[8] + lam * ga.z), det);
        const vec3 sy = solve3(m, vec3(a[9] + lam * gb.x, a[10] + lam * gb.y, a[11] + lam * gb.z), det);
        if (abs(det) > 1e-12) { pa = sx; pb = sy; }
    }
    // the model's reliability here: the weighted rms residual of the samples (each capped at 4 level px: a still foreground is an outlier, not a measure) in level px; a region
    // whose samples a single affine model does not describe (parallax: a near cliff beside a far road) votes weakly
    float q = 0.0;
    {
        float a[12];
        for (int k = 0; k < 12; k++) a[k] = 0.0;
        for (int j = 0; j < NC; j++) {
            const vec2 x = cs[j].xy, d = cs[j].zw;
            const float w = cw[j];
            if (w <= 0.0) continue;
            const vec2 qq = (x - cc) / cc;
            const vec2 m = vec2(dot(pa, vec3(1.0, qq)), dot(pb, vec3(1.0, qq)));
            const float r = min(length(d - m) / sc, 6.0);
            a[0] += w * r * r; a[1] += w;
        }
        red12(a);
        q = 1.0 - smoothstep(1.5, 4.0, sqrt(a[0] / max(a[1], 1e-6)));
    }
    if (tid == 0) {
        const int o = g + G35_REG + 8 * reg;
        const bool ok = wsum * float(step) >= 30.0 && all(lessThan(abs(pa), vec3(4096.0))) && all(lessThan(abs(pb), vec3(4096.0)));
        ax[o] = floatBitsToUint(ok ? pa.x : ga.x); ax[o + 1] = floatBitsToUint(ok ? pa.y : ga.y); ax[o + 2] = floatBitsToUint(ok ? pa.z : ga.z);
        ax[o + 3] = floatBitsToUint(ok ? pb.x : gb.x); ax[o + 4] = floatBitsToUint(ok ? pb.y : gb.y); ax[o + 5] = floatBitsToUint(ok ? pb.z : gb.z);
        ax[o + 6] = floatBitsToUint(ok ? q : 0.5 * q);
        ax[o + 7] = ok ? 1u : (gv ? 2u : 0u);
    }
}
