#version 450
#extension GL_GOOGLE_include_directive : require
// V2, synth (after v2_error, V2Knobs holdFeather > 0 only; I11): the soft hold edge's map of this t (v2_hold_core.glsl) from e
// (u[E_OFF..]) into v2b[] at v2HOff() (v2_temporal.glsl), one float per 4 x 4 px cell. Push constants: PC2, with edgeMin = the
// feather (px), as for v2_resolve.comp.
#include "common.glsl"
#include "motion_v2.glsl"
#include "v2_temporal.glsl"
layout(local_size_x = 16, local_size_y = 16) in;

#define HOLD_EW(p) u[E_OFF + (p).y * E_STRIDE + ((p).x >> 2)]
#define HOLD_OUT(c, v) v2b[v2HOff() + (c).y * ((pc.W + 3) >> 2) + (c).x] = floatBitsToUint(v)
#define HOLD_W pc.W
#define HOLD_H pc.H
#define HOLD_F pc.edgeMin
#define HOLD_T0 pc.trust0
#define HOLD_TS pc.trustScale
#include "v2_hold_core.glsl"

void main() { holdMain(); }
