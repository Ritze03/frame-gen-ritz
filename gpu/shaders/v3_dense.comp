#version 450
#extension GL_GOOGLE_include_directive : require
// MotionVersion::V3, build step E1 (gpu/V3.md section 3.8): the soft per-pixel field from the level-0 block field. Dispatch: tiles of 8x8 flow px
// offset by (-4, -4), so each tile lies between 4 block centres (blocks of 8x8: centres at 8 i + 3.5), ceil((fw + 4) / 8) x ceil((fh + 4) / 8) x 2
// (z = direction), workgroup 64, one flow pixel per thread. Reads BLK[0][dir][0] (vx, vy, cost, amb) of the 4 surrounding blocks, feat[0], G.sum
// (dMu); writes FD[dir] (vec2 per flow px), the cost byte of MAP[dir] and, with mode bit 1 (until step Y1 adds v3_fill, which writes FF), FF[dir] = FD.
//  - the 4 block vectors within 0.5 flow px of each other (a branch uniform over the workgroup): v = the bilinear blend (position weights), cost =
//    the bilinear blend of the block costs;
//  - else per pixel: the cost of each of the 4 vectors over a 5x5 window of features (4 channels as in v3Term, bilinear taps at the sub-pixel
//    vector, dMu), c_min = min; w_k = bil_k exp(-max(0, c_k - c_min) / TAU), v = sum w_k v_k / sum w_k, cost = c_min.
//  - mode bit 2 (inject, tests only): FD already holds the caller's vector, the only candidate: its cost over the same window is written to MAP
//    and nothing else changes.
// Hook (j) (v3ColourWindow, the v3_dense_j build, V3J = 1): the 5x5 window's pixels carry the weight wgt = exp(-|colour(x) - colour(p)|_1 / 24) of the
// role-0 frame's raw (Y, Cb, Cr) around the pixel p, and the window cost is sum(wgt t) / sum(wgt) (a pixel with no term does not count in either); the
// 'half the window has a term' test stays on the unweighted count. The inject mode (tests) and the 4-vectors-agree branch (no cost map) are not weighted.
#ifndef V3J
#define V3J 0
#endif
// V35 = 1 (the v3_dense_35 build, Settings::v3Motion = 1, V3.5): where the 4x4 blocks around the tile form one smooth motion (no neighbouring pair differs by more than
// V35_EDGE flow px) the vector is the Catmull-Rom interpolation of the block vectors (C1: no kink at the block centres, and a locally linear field, rotation or zoom, is
// reproduced exactly, where the bilinear blend of the 4 nearest has a kink at every centre and the "agree within 0.5" test sends such a field into the soft pick);
// the cost is the bilinear blend of the blocks' costs as before. Every other tile is the unchanged code. The zero-vector bonus (hudBonus) is not used by V3.5.
#ifndef V35
#define V35 0
#endif
#include "common.glsl"
#include "v3_common.glsl"
#include "v3_est.glsl"
layout(local_size_x = 8, local_size_y = 8) in;

const float TAU = 1.5;
const float BAD = 255.0;
const int M_FF = 2, M_INJECT = 4;
const float V35_EDGE = 2.0;   // flow px: a neighbouring pair of block vectors further apart than this is a motion edge, not a smooth field

float cr1(float t, int k) {   // Catmull-Rom weight k (0..3) at t
    const float t2 = t * t, t3 = t2 * t;
    return k == 0 ? -0.5 * t3 + t2 - 0.5 * t : k == 1 ? 1.5 * t3 - 2.5 * t2 + 1.0 : k == 2 ? -1.5 * t3 + 2.0 * t2 + 0.5 * t : 0.5 * t3 - 0.5 * t2;
}

// mean cost of vector v at pixel p over the 5x5 window (invalid, 255, when fewer than half of the window's pixels have their target inside).
// The bilinear weights are the same for every window pixel (one sub-pixel offset), so the 6x6 integer texels under the window's targets are read
// once, row by row, and interpolated in registers (36 reads instead of 100).
float winCost(const V3Lv L, int fOff, int dir, vec2 dMu, ivec2 p, vec2 v) {
    const vec2 vf = floor(v), fr = v - vf;
    const ivec2 vi = ivec2(vf);
    const ivec2 mx = ivec2(L.w - 1, L.h - 1);
    float s = 0.0, n = 0.0;
    vec4 prow[6];
    {
        const int ty = clamp(p.y - 2 + vi.y, 0, mx.y);
        for (int i = 0; i < 6; i++) prow[i] = v3FeatAt(L, fOff, 1 - dir, ivec2(clamp(p.x - 2 + vi.x + i, 0, mx.x), ty));
    }
    for (int j = -2; j <= 2; j++) {
        vec4 nrow[6];
        const int ty = clamp(p.y + j + 1 + vi.y, 0, mx.y);
        for (int i = 0; i < 6; i++) nrow[i] = v3FeatAt(L, fOff, 1 - dir, ivec2(clamp(p.x - 2 + vi.x + i, 0, mx.x), ty));
        for (int i = -2; i <= 2; i++) {
            const ivec2 x = p + ivec2(i, j);
            if (x.x < 0 || x.y < 0 || x.x >= L.w || x.y >= L.h) continue;
            const vec2 tq = vec2(x) + v;
            if (tq.x < 0.0 || tq.y < 0.0 || tq.x > float(L.w - 1) || tq.y > float(L.h - 1)) continue;
            const vec4 b = mix(mix(prow[i + 2], prow[i + 3], fr.x), mix(nrow[i + 2], nrow[i + 3], fr.x), fr.y);
            s += v3Term(v3FeatAt(L, fOff, dir, x), b, dMu);
            n += 1.0;
        }
        prow = nrow;
    }
    return n >= 12.5 ? min(s / n, BAD) : BAD;
}

shared float zmap[144];       // task 105: the zero vector's term of every pixel of the tile with its apron (-1 = outside)
shared float dmap[144];       // task 105: the detail of the role-0 frame at every pixel of the tile with its apron
shared float tmap[4 * 144];   // per candidate: the matching term of every pixel of the tile with a 2 px apron (12x12), -1 = no term (outside)
#if V3J
shared vec3 tcol[144];        // the role-0 raw colour of every pixel of the tile with its apron (the weights' source)
#endif

void main() {
    const int dir = int(gl_WorkGroupID.z);
    const ivec2 lp = ivec2(gl_LocalInvocationID.xy);
    const int lid = int(gl_LocalInvocationIndex);
    const ivec2 p = ivec2(gl_WorkGroupID.xy) * 8 - 4 + lp;
    int P, Bw, nLev;
    v3Totals(P, Bw, nLev);
    const V3Lv L = v3Lv(0);
    const int N = pc.fw * pc.fh;
    const int fOff = 2 * P;
    const vec2 dMu = v3DMu(dir);
    const bool inFrame = p.x >= 0 && p.y >= 0 && p.x < L.w && p.y < L.h;
    const int pix = p.y * L.w + p.x;
    const int fd = Bw + dir * 2 * N + 2 * pix, ff = Bw + 4 * N + dir * 2 * N + 2 * pix;
    const int mapI = mapOff(dir) + pix;

    if ((pc.mode & M_INJECT) != 0) {
        if (!inFrame) return;
        const float c = winCost(L, fOff, dir, dMu, p, vec2(fl[fd], fl[fd + 1]));
        ax[mapI] = uint(min(255.0, floor(8.0 * c + 0.5)));
        return;
    }

    // the tile's 4 surrounding blocks (uniform over the workgroup): block k covers 8 px from 8 k, centre 8 k + 3.5; this pixel's bilinear weights
    const ivec2 t0 = ivec2(gl_WorkGroupID.xy) - 1;
    vec4 rec[4];
    for (int k = 0; k < 4; k++) {
        const int o = v3BlkIdx(L, dir, 0, t0 + ivec2(k & 1, k >> 1));
        rec[k] = vec4(fl[o], fl[o + 1], fl[o + 2], 0.0);
    }
    float spread = 0.0, vmax = 0.0;
    for (int i = 0; i < 4; i++) {
        vmax = max(vmax, length(rec[i].xy));
        for (int j = i + 1; j < 4; j++) spread = max(spread, length(rec[i].xy - rec[j].xy));
    }
    // task 105: the zero vector as a candidate (hudBonus > 0; not where every block vector is nearly zero: it adds nothing there)
#if V35
    {   // the smooth-field test over the 4x4 blocks around the tile (uniform over the workgroup)
        vec2 g[16];
        bool isSmooth = true;
        for (int k = 0; k < 16; k++) {
            const int o = v3BlkIdx(L, dir, 0, t0 + ivec2(k & 3, k >> 2) - 1);
            g[k] = vec2(fl[o], fl[o + 1]);
        }
        for (int j = 0; j < 4; j++)
            for (int i = 0; i < 4; i++) {
                if (i < 3 && length(g[j * 4 + i] - g[j * 4 + i + 1]) > V35_EDGE) isSmooth = false;
                if (j < 3 && length(g[j * 4 + i] - g[(j + 1) * 4 + i]) > V35_EDGE) isSmooth = false;
            }
        if (isSmooth) {
            if (!inFrame) return;
            const vec2 u = (vec2(p) - 3.5) * 0.125;
            const vec2 a = u - vec2(floor(u));
            vec2 vv = vec2(0.0);
            for (int j = 0; j < 4; j++)
                for (int i = 0; i < 4; i++) vv += cr1(a.x, i) * cr1(a.y, j) * g[j * 4 + i];
            const float bw4[4] = float[4]((1.0 - a.x) * (1.0 - a.y), a.x * (1.0 - a.y), (1.0 - a.x) * a.y, a.x * a.y);
            float cc = 0.0;
            for (int k = 0; k < 4; k++) cc += bw4[k] * rec[k].z;
            fl[fd] = vv.x; fl[fd + 1] = vv.y;
            if ((pc.mode & M_FF) != 0) { fl[ff] = vv.x; fl[ff + 1] = vv.y; }
            ax[mapI] = uint(min(255.0, floor(8.0 * cc + 0.5)));
            return;
        }
    }
#endif
    bool needZ = pc.hudB > 0.0 && vmax * float(pc.fscale) >= pc.hp[3];
    if (needZ && Bw > 0 && nLev > 1) {   // the pre-test: some block of the 4 has evidence of a still part (level 0's slot 1, .z)
        float zmax = 0.0;
        for (int k = 0; k < 4; k++) zmax = max(zmax, fl[v3BlkIdx(L, dir, 1, t0 + ivec2(k & 1, k >> 1)) + 2]);
        needZ = zmax > V3H_BLKE;
    }
    //    // (the gate's lower edge: slower motion takes no bonus, and costs nothing)
    const ivec2 zto = ivec2(gl_WorkGroupID.xy) * 8 - 6;   // the apron's corner
    if (needZ) {
        for (int idx = lid; idx < 144; idx += 64) {
            const ivec2 x = zto + ivec2(idx % 12, idx / 12);
            float t = -1.0, dt = 0.0;
            if (x.x >= 0 && x.y >= 0 && x.x < L.w && x.y < L.h) {
                const vec4 a0 = v3FeatAt(L, fOff, dir, x);
                t = v3Term(a0, v3FeatAt(L, fOff, 1 - dir, x), dMu);
                dt = v3Detail(a0);
            }
            zmap[idx] = t;
            dmap[idx] = dt;
        }
    }
    const vec2 u = (vec2(p) - 3.5) * 0.125;
    const vec2 a = u - vec2(floor(u));
    const float bwt[4] = float[4]((1.0 - a.x) * (1.0 - a.y), a.x * (1.0 - a.y), (1.0 - a.x) * a.y, a.x * a.y);
    vec2 v = vec2(0.0);
    float cost = 0.0;
    if (spread < 0.5) {
        if (needZ) barrier();
        if (!inFrame) return;
        for (int k = 0; k < 4; k++) { v += bwt[k] * rec[k].xy; cost += bwt[k] * rec[k].z; }
        if (needZ) {   // task 105: against the blocks' cost (the vectors agree: no per-pixel costs of them)
            float zs = 0.0, nz = 0.0, c0 = BAD, det = 0.0, nm = 0.0;
            for (int j = 0; j < 5; j++)
                for (int i = 0; i < 5; i++) {
                    const float t = zmap[(lp.y + j) * 12 + lp.x + i];
                    if (t >= 0.0) { zs += t; det += dmap[(lp.y + j) * 12 + lp.x + i]; nz += 1.0; nm += t < pc.hp[1] ? 1.0 : 0.0; }
                }
            if (nz >= 12.5) {
                c0 = min(zs / nz, BAD);
                const float z = v3HudEv(det / nz) * v3HudAbs(c0) * smoothstep(V3H_FR0, V3H_FR1, nm / nz) * smoothstep(V3H_D0, V3H_D0 + 1.5, cost - (c0 - pc.hudB)) * v3HudGate(length(v) * float(pc.fscale));
                v *= 1.0 - z;
                cost = mix(cost, c0, z);
            }
        }
    } else {
        // the cost of each distinct vector at each pixel of the tile and its apron, once (a 5x5 box sum of them per pixel afterwards), instead of
        // 25 bilinear windows per pixel; a vector within 0.25 px of an earlier one shares its map
        int rep[4];
        for (int k = 0; k < 4; k++) {
            rep[k] = k;
            for (int j = 0; j < k; j++)
                if (length(rec[j].xy - rec[k].xy) < 0.25) { rep[k] = rep[j]; break; }
        }
        const ivec2 to = ivec2(gl_WorkGroupID.xy) * 8 - 6;   // the apron's corner
        for (int idx = lid; idx < 4 * 144; idx += 64) {
            const int k = idx / 144, q = idx - k * 144;
            if (rep[k] != k) continue;
            const ivec2 x = to + ivec2(q % 12, q / 12);
            float t = -1.0;
            if (x.x >= 0 && x.y >= 0 && x.x < L.w && x.y < L.h) {
                const vec2 tq = vec2(x) + rec[k].xy;
                if (tq.x >= 0.0 && tq.y >= 0.0 && tq.x <= float(L.w - 1) && tq.y <= float(L.h - 1))
                    t = v3Term(v3FeatAt(L, fOff, dir, x), v3FeatBil(L, fOff, 1 - dir, tq), dMu);
            }
            tmap[idx] = t;
        }
#if V3J
        for (int idx = lid; idx < 144; idx += 64) {
            const ivec2 x = to + ivec2(idx % 12, idx / 12);
            tcol[idx] = (x.x >= 0 && x.y >= 0 && x.x < L.w && x.y < L.h) ? v3RawAt(L, dir, x) : vec3(0.0);
        }
#endif
        barrier();
        if (!inFrame) return;
        float c[4], cmin = 1e9;
#if V3J
        float cw[25];   // the window's colour weights around this pixel (the same for the 4 vectors)
        {
            const vec3 cen = tcol[(lp.y + 2) * 12 + lp.x + 2];
            for (int j = 0; j < 5; j++)
                for (int i = 0; i < 5; i++) cw[j * 5 + i] = v3ColourWgt(tcol[(lp.y + j) * 12 + lp.x + i], cen);
        }
#endif
        for (int k = 0; k < 4; k++) {
            if (rep[k] != k) { c[k] = c[rep[k]]; continue; }
            float s = 0.0, n = 0.0;
#if V3J
            float ws = 0.0;
#endif
            for (int j = 0; j < 5; j++)
                for (int i = 0; i < 5; i++) {
                    const float t = tmap[k * 144 + (lp.y + j) * 12 + lp.x + i];
#if V3J
                    if (t >= 0.0) { s += cw[j * 5 + i] * t; ws += cw[j * 5 + i]; n += 1.0; }
#else
                    if (t >= 0.0) { s += t; n += 1.0; }
#endif
                }
#if V3J
            c[k] = (n >= 12.5 && ws > 0.0) ? min(s / ws, BAD) : BAD;
#else
            c[k] = n >= 12.5 ? min(s / n, BAD) : BAD;
#endif
            cmin = min(cmin, c[k]);
        }
        for (int k = 0; k < 4; k++) cmin = min(cmin, c[k]);
        float ws = 0.0;
        for (int k = 0; k < 4; k++) {
            const float w = bwt[k] * exp(-max(0.0, c[k] - cmin) * (1.0 / TAU));
            v += w * rec[k].xy;
            ws += w;
        }
        v /= ws;
        cost = cmin;
        if (needZ) {   // task 105: the zero vector against the best of the 4 (same window, same weights)
            float zs = 0.0, nz = 0.0, det = 0.0, wz = 0.0, nm = 0.0;
            for (int j = 0; j < 5; j++)
                for (int i = 0; i < 5; i++) {
                    const float t = zmap[(lp.y + j) * 12 + lp.x + i];
#if V3J
                    if (t >= 0.0) { zs += cw[j * 5 + i] * t; wz += cw[j * 5 + i]; det += dmap[(lp.y + j) * 12 + lp.x + i]; nz += 1.0; nm += t < pc.hp[1] ? 1.0 : 0.0; }
#else
                    if (t >= 0.0) { zs += t; wz += 1.0; det += dmap[(lp.y + j) * 12 + lp.x + i]; nz += 1.0; nm += t < pc.hp[1] ? 1.0 : 0.0; }
#endif
                }
            if (nz >= 12.5 && wz > 0.0) {
                const float c0 = min(zs / wz, BAD);
                const float z = v3HudEv(det / nz) * v3HudAbs(c0) * smoothstep(V3H_FR0, V3H_FR1, nm / nz) * smoothstep(V3H_D0, V3H_D0 + 1.5, cmin - (c0 - pc.hudB)) * v3HudGate(length(v) * float(pc.fscale));
                v *= 1.0 - z;
                cost = mix(cost, c0, z);
            }
        }
    }
    fl[fd] = v.x; fl[fd + 1] = v.y;
    if ((pc.mode & M_FF) != 0) { fl[ff] = v.x; fl[ff + 1] = v.y; }
    ax[mapI] = uint(min(255.0, floor(8.0 * cost + 0.5)));
}
