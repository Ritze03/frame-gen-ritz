#version 450
#extension GL_GOOGLE_include_directive : require
// MotionVersion::V3's synthesis (gpu/V3.md section 3.15), build step Y2: the two-hypothesis gather with the smear, the pixel clamp, the static mask,
// the CrosshairV2 tap rejection and the whole-frame cut. One full-resolution pass; all n samples of the output are averaged in registers: n = 1 for
// recordSynth, recordSynthBlur's N sub-frames otherwise, each exactly what recordSynth(t_k) gives (V3_QUANT), averaged with even or Gaussian weights
// (blur_resolve.comp's: exp(-2 x^2), x = (2k + 1 - n) / n) and rounded once by the store. Sample times t_k are the host's (G words 1200..: the same
// numbers v3_project used); a sample at t <= 0 / >= 1 is the real frame prev / curr. The interior samples (0 < t < 1) are contiguous: v3_project wrote
// their T-field records, slot k - pc.iter (pc.lvl = their count).
// Per interior sample:
//   1. G.mode == 1 (scene cut, v3_decide): the nearer real frame (prev for t <= 0.5), whole frame, nothing else runs.
//   2. TF: the two projected vectors gA, gB bilinear over the 4 flow px around x (full-resolution vector = fs x the flow vector), the scalars
//      (o, hole, u of A and B) bilinear as well; the pixel's static bits (C of v3_enclose: an overlay near / near a tap).
//   3. taps (positions rounded to 1/32 px by V3_TAP): A: prev(x - t gA), curr(x + (1 - t) gA); B: curr(x - (1 - t) gB), prev(x + t gB); each pair through
//      CrosshairV2's uiReject on the raw texels, a tap outside the frame takes its partner (softly over 2 px), a tap on a static overlay takes its
//      partner (sReject, near overlays only).
//   4. the weight stage (v3_weights.glsl): w[4] and the smear s; sharp colour Cs = sum w_i C_i.
//   5. the pixel clamp: Cs is limited, per channel, to the range of the 3x3 texels around each tap of the dominant hypothesis (both, where the weights
//      of the two are within 0.25): the output never holds a colour the sources do not show next to the places it was taken from.
//   6. the smear along the motion where the estimate is unsure: 4 more sets of the 4 taps at times t + j tau (tau = v3Smear s / 2, j = -2, -1, 1, 2; each
//      hypothesis along its own vector, at most 48 px), weights as in 4, mixed (1,2,3,2,1)/9 with the clamped Cs in the middle; the result replaces Cs by
//      smoothstep(0.05, 0.5, s). An unsure pixel's colour comes from real source pixels along its own motion, never from the same place of a real frame.
//   7. the static mask: where the two real frames show the same structure at x (a HUD stroke, a semi-transparent panel) the pixel takes the zero-vector
//      time blend (1 - t) prev(x) + t curr(x) by the static weight (v2_morph.glsl's decision: S confirmed at full resolution, E, both taps on it).
//   8. quantise exactly as the store does (V3_QUANT), accumulate with the blur weights; store.
// Mode bits (V3PC.mode): 1 Gaussian blur weights, 2 hook (l) detail split (host: selects the -DV3L=1 build, which does not read the bit), 8 debug dump: the 28-float record of the weight stage
// per output pixel (V3.md 3.16), every pc.lw-th pixel of the raster, the first pc.lh of them, into the T-field slot after the interior ones.
// Settings::v3Blend (-DV3B=1 build, P_V3_SYNTH_B, Rgba8 / Bgra8 only): mode bits 4..7 = the variant 1..V3B_NETS (1 Fluidity, 2 Consistency; host: V3M_BLEND_SHIFT, kV3BlendMax); the plain build does not read them.
// The per-format variants (step F) go through the V3_* macros of v3_format.glsl (YUV also writes its CbCr plane once per 2x2 block, as v2_morph.glsl).
#include "common.glsl"
#include "v3_common.glsl"
#include "v3_format.glsl"
#include "v3_weights.glsl"
#if defined(V3B)
#include "v3_blend.glsl"
#endif
#include "v3_static.glsl"
layout(local_size_x = 8, local_size_y = 8) in;

// Hook (l) v3DetailSplit (V3.md 3.16 "As built (l)"): the same source compiled with -DV3L=1 (gpu/meson.build v3l_gen, header v3_synth_l[_<fmt>]_spv.h,
// pipeline P_V3_SYNTH_L). Without the define none of the code below exists: the plain build's SPIR-V is what it was.
#if defined(V3L)
#define V3L_PAR , out float va, out float vc
#define V3L_ARG(a, b) , a, b
#define V3L_DUM , vd0_, vd1_
float vd0_, vd1_;
// the tuning constants of the detail split (V3.md 3.16 "As built (l)")
#ifndef V3L_SQ
#define V3L_SQ 4            // the dominance power is 2^V3L_SQ (16): a sharpened share of the weight
#endif
#ifndef V3L_TILT
#define V3L_TILT 0.1        // added to a curr tap's weight before the power: where prev and curr are equal (t = 0.5) the detail is curr's, not an average
#endif
#ifndef V3L_GAIN
#define V3L_GAIN 1.0        // the share of the detail correction that is applied
#endif
#ifndef V3L_V0
#define V3L_V0 2.0          // a working value this many levels from its tap's own colour is a rejection's replacement (validity ramp, levels)
#endif
#ifndef V3L_V1
#define V3L_V1 10.0
#endif
float max3(vec3 v) { return max(v.r, max(v.g, v.b)); }
#else
#define V3L_PAR
#define V3L_ARG(a, b)
#define V3L_DUM
#endif

// A tap outside the frame reads the clamped edge: where content enters or leaves the view only the other frame shows it, so the tap takes its partner
// (softly over V3_OUT px past the edge; both outside: as is). As v2_morph.glsl's outside() / edgeReject().
const float V3_OUT = 2.0;
const float V3_LAT = 3.0, V3_LAT0 = 0.5, V3_LAT1 = 1.0;   // (tuning 3) lateral radius (px) of the smear sets (3: 6 broke uitest's CrosshairV2 checks, 13 artifact px instead of 1), and the smear value it ramps over
float outside(vec2 p) {
    const vec2 o = max(-0.5 - p, p - vec2(pc.W, pc.H) + 0.5);
    return clamp(max(o.x, o.y) * (1.0 / V3_OUT), 0.0, 1.0);
}
// how far past the frame edge a tap lies, as a ramp from V3_FAR0 to V3_FAR1 px (a tap just past the edge is content entering or leaving: edgeReject)
const float V3_FAR0 = 16.0, V3_FAR1 = 48.0;
float outsideFar(vec2 p) {
    const vec2 o = max(-0.5 - p, p - vec2(pc.W, pc.H) + 0.5);
    return smoothstep(V3_FAR0, V3_FAR1, max(o.x, o.y));
}
void edgeReject(vec2 pa, vec2 pb, inout vec3 ca, inout vec3 cb_) {
    const float oa = outside(pa), ob = outside(pb);
    const vec3 a = ca;
    ca = mix(ca, cb_, clamp(oa - ob, 0.0, 1.0));
    cb_ = mix(cb_, a, clamp(ob - oa, 0.0, 1.0));
}

// One hypothesis' pair of taps, pa on prev and pc_ on curr: the working values wa, wc after CrosshairV2's tap rejection (on the raw texels), the edge
// rule and, near a static overlay (nearT), the overlay's tap rule; so = (sout, sboth, sbS) of v2_morph.glsl's sReject (sout = 1 away from overlays: the
// taps leave them, 0 at the zero vector); em0 = the pair's disagreement before the overlay rule (the taps' own fit).
void v3Pair(vec2 pa, vec2 pc_, bool nearT, out vec3 wa, out vec3 wc, out vec3 so, out float em0, out float hit V3L_PAR) {
    hit = 0.0;
    const vec4 a = V3_TAP(texPrev, texPrevC, pa), c = V3_TAP(texCurr, texCurrC, pc_);
    vec3 ra = a.rgb, rc = c.rgb;
    uiReject(V3_UIP(pa), V3_UIP(pc_), ra, rc);
    wa = V3_LEVELS(ra);
    wc = V3_LEVELS(rc);
    edgeReject(pa, pc_, wa, wc);
    const vec3 d0 = V3_D(wa, wc);
    em0 = max(d0.r, max(d0.g, d0.b));
    so = vec3(all(lessThan(abs(pc_ - pa), vec2(1.0))) ? 0.0 : 1.0, 0.0, 0.0);
    if (nearT) {
        const vec2 za2 = sOverAt(pa, sCell(pa)), zc2 = sOverAt(pc_, sCell(pc_));
        // (tuning D2) how much of a static overlay either tap hits (not at the zero vector, where both taps are the overlay's own place): the hypothesis is vetoed by the caller
        if (!all(lessThan(abs(pc_ - pa), vec2(1.0)))) hit = clamp(max(max(za2.x, zc2.x), max(eBil(pa), eBil(pc_))), 0.0, 1.0);   // (tuning 2) S texels and E bilinear (the cell constant E made 16 px blocks of vetoed taps)
        so = sReject(pa, pc_, wa, wc, za2, zc2);
        if (so.z > 0.0) so.z *= tapsStatic(pa, pc_, a.rgb, c.rgb);
        if (so.y > 0.0) {   // (not where both taps are on CrosshairV2's UI: its patch and its own tap rule decide there)
            bool ha, hc;
            uiRejectHits(V3_UIP(pa), V3_UIP(pc_), ha, hc);
            if (ha && hc) so.y = 0.0;
        }
    }
#if defined(V3L)
    // (hook (l)) how much of each working value is still the tap's own colour: the rejections (CrosshairV2, the frame edge, a static overlay) replace a tap by
    // its partner's, and a value that is not the texels' own has no detail of its own: value minus the local mean would be the partner's against this place's
    va = 1.0 - smoothstep(V3L_V0, V3L_V1, max3(V3_D(wa, V3_LEVELS(a.rgb))));
    vc = 1.0 - smoothstep(V3L_V0, V3L_V1, max3(V3_D(wc, V3_LEVELS(c.rgb))));
    // a tap whose 3x3 texels (its detail and its low-pass) touch CrosshairV2's patch has no detail of its own either: the crosshair is the UI's, not the picture's
    {
        const ivec2 qa = ivec2(floor(V3_UIP(pa) + 0.5)), qc = ivec2(floor(V3_UIP(pc_) + 0.5));
        if (uiHitA(qa - 2, qa + 2)) va = 0.0;
        if (uiHitC(qc - 2, qc + 2)) vc = 0.0;
    }
#endif
}

// the range (raw texel values) of the 3x3 texels around the texel nearest to the tap position pos
void v3Box(bool onCurr, vec2 pos, inout vec3 lo, inout vec3 hi) {
    pos = roundEven(pos * 32.0) * (1.0 / 32.0);
    const ivec2 c = ivec2(floor(pos + 0.5));
    const ivec2 mx = ivec2(pc.W - 1, pc.H - 1);
    for (int j = -1; j <= 1; j++)
        for (int i = -1; i <= 1; i++) {
            const ivec2 q = clamp(c + ivec2(i, j), ivec2(0), mx);
            const vec3 v = onCurr ? V3_PX(texCurr, texCurrC, q).rgb : V3_PX(texPrev, texPrevC, q).rgb;
            lo = min(lo, v);
            hi = max(hi, v);
        }
}

#if defined(V3L)
// v3Box and the mean of the same 9 texels (the 3x3 low-pass of the tap, raw values); box = false: only the mean
void v3BoxMean(bool onCurr, vec2 pos, bool box, inout vec3 lo, inout vec3 hi, out vec3 mean) {
    pos = roundEven(pos * 32.0) * (1.0 / 32.0);
    const ivec2 c = ivec2(floor(pos + 0.5));
    const ivec2 mx = ivec2(pc.W - 1, pc.H - 1);
    vec3 sum = vec3(0.0);
    for (int j = -1; j <= 1; j++)
        for (int i = -1; i <= 1; i++) {
            const ivec2 q = clamp(c + ivec2(i, j), ivec2(0), mx);
            const vec3 v = onCurr ? V3_PX(texCurr, texCurrC, q).rgb : V3_PX(texPrev, texPrevC, q).rgb;
            sum += v;
            if (box) { lo = min(lo, v); hi = max(hi, v); }
        }
    mean = sum * (1.0 / 9.0);
}
float v3Pow(float x) {   // x^(2^V3L_SQ)
    for (int i = 0; i < V3L_SQ; i++) x *= x;
    return x;
}
#endif

// the static weight of the pixel p: the zero-vector time blend takes over where the two real frames show the same structure at p (v2_morph.glsl's
// decision with the dominant mix of the two hypotheses' values: em = the pair disagreement after the overlay rule, em0 before it, so = (sout, sboth, sbS)).
// sa, sc: the two frames' working values at p.
float v3StaticWeight(ivec2 p, uint sbits, vec3 sa, vec3 sc, float em, float em0, vec3 so) {
    const float sout = so.x, sboth = so.y, sbS = so.z;
    const vec3 s3 = sAt(vec2(p), sbits);   // S (nearest flow px), E (enclosure), S dilated by ~1 flow px
    const vec2 sp = s3.xy;
    const float sxd = s3.z;
    float ws = 0.0;
    if (em > V3_Z0 || sxd > 0.0 || sp.y * sout > 0.0 || sboth > 0.0) {   // (only then can the zero vector win)
        const vec3 dz = V3_D(sa, sc);
        const float z = max(dz.r, max(dz.g, dz.b));
        // ... and so do both neighbours along x or along y (a stroke): a lone pixel that happens to match in a moving texture does not switch
        float zn[4];
        float num = 0.0, den = 0.0;
        const bool inS = sxd > 0.0;
        for (int k = 0; k < 4; k++) {
            const ivec2 o = k < 2 ? ivec2(2 * k - 1, 0) : ivec2(0, 2 * k - 5);
            const ivec2 pn = clamp(p + o, ivec2(0), ivec2(pc.W - 1, pc.H - 1));
            const vec3 an = V3_LEVELS(V3_PX(texPrev, texPrevC, pn).rgb), cn = V3_LEVELS(V3_PX(texCurr, texCurrC, pn).rgb);
            const vec3 d = V3_D(an, cn);
            zn[k] = max(d.r, max(d.g, d.b));
            if (inS) {
                const vec3 ga = V3_G(sa, an), gc = V3_G(sc, cn);
                const vec3 gd = abs(ga - gc), gm = max(abs(ga), abs(gc));
                num += max(gd.r, max(gd.g, gd.b));
                den += max(gm.r, max(gm.g, gm.b));
            }
        }
        const float zh = max(zn[0], zn[1]), zv = max(zn[2], zn[3]);
        const float zs = max(z, min(zh, zv));
        ws = clamp((em - zs - V3_Z0) * (1.0 / V3_Z1), 0.0, 1.0) * clamp(1.0 - zs * (1.0 / V3_ZMAX), 0.0, 1.0);
        // not next to CrosshairV2's UI (its own patch and tap rejection handle it)
        if (ws > 0.0 && (uiHitA(p - 1, p + 1) || uiHitC(p - 1, p + 1))) ws = 0.0;
        // a static structure (the mask, dilated by ~1 flow px: the rim of a stroke), confirmed at full resolution: the pixel and its neighbours agree, or
        // their structure does (a semi-transparent overlay) where there is structure at all
        if (inS) {
            const float rf = num / (den + V3_SEPS);
            const bool onUi = uiHitA(p, p) || uiHitC(p, p);
            const float conf = max(onUi ? 0.0 : clamp((V3_SR1 - rf) * (1.0 / (V3_SR1 - V3_SR0)), 0.0, 1.0) * clamp((den - V3_SD0) * (1.0 / V3_SD1), 0.0, 1.0),
                                   clamp(1.0 - zs * (1.0 / V3_ZMAX), 0.0, 1.0));
            ws = max(ws, sxd * conf);
        }
        // inside an overlay (E) whose taps leave it, and both taps on the overlay: the overlay's own place, unless the taps' own fit is clearly better
        const float fitM = clamp((zs - em0 - V3_Z0) * (1.0 / V3_Z1), 0.0, 1.0);
        ws = max(ws, sp.y * sout * (1.0 - fitM));
        ws = max(ws, sboth * (1.0 - fitM));
        ws = max(ws, sbS);
    }
    return ws;
}

void main() {
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.W || p.y >= pc.H) return;
    const int N = pc.fw * pc.fh;
    const float fsc = float(pc.fscale);
    // the flow-px neighbourhood of this pixel (flow px m has its centre at fs m + (fs - 1)/2): 4 records, bilinear weights
    const vec2 fp = (vec2(p) - 0.5 * (fsc - 1.0)) / fsc;
    const ivec2 f0 = ivec2(floor(fp));
    const vec2 fa = fp - vec2(f0);
    ivec2 fc[4];
    for (int k = 0; k < 4; k++) fc[k] = clamp(f0 + ivec2(k & 1, k >> 1), ivec2(0), ivec2(pc.fw - 1, pc.fh - 1));
    const float bw[4] = float[4]((1.0 - fa.x) * (1.0 - fa.y), fa.x * (1.0 - fa.y), (1.0 - fa.x) * fa.y, fa.x * fa.y);
    const vec4 s0 = V3_PX(texPrev, texPrevC, p), s1 = V3_PX(texCurr, texCurrC, p);
    const bool cut = ax[gOff() + G_MODE] == 1u;
    const uint sbits = sCellBits(sCell(vec2(p)));   // C of v3_enclose: bit 0 an overlay near this pixel, bit 1 a tap of this pixel can land near one
    const bool nearS = (sbits & 1u) != 0u, nearT = (sbits & 2u) != 0u;

    vec3 acc = vec3(0.0);
    float accA = 0.0, ws = 0.0;
    for (int k = 0; k < pc.n; k++) {
        const float t = uintBitsToFloat(ax[gOff() + G_TK + k]);   // the host's t_k (v3Synth writes them: t0 + (t1 - t0)(k + 0.5)/n in double, clamped)
        const float x = (2.0 * float(k) + 1.0 - float(pc.n)) / float(pc.n);
        const float w = (pc.mode & V3M_GAUSS) != 0 ? exp(-2.0 * x * x) : 1.0;
        vec3 v;
        float a;
        if (t <= 0.0 || (cut && t <= 0.5)) {
            v = V3_LEVELS(s0.rgb); a = s0.a;
        } else if (t >= 1.0 || cut) {
            v = V3_LEVELS(s1.rgb); a = s1.a;
        } else {
            const int tf = pc.fdOff + 8 * N + (k - pc.iter) * 4 * N;
            vec2 gA = vec2(0.0), gB = vec2(0.0);
            vec4 rA = vec4(0.0), rB = vec4(0.0);   // (o, hole, u, 0) of A and B: bilinear too (a ramp of a few px, not a step at the flow grid)
            for (int j = 0; j < 4; j++) {
                const int o = tf + 4 * (fc[j].y * pc.fw + fc[j].x);
                gA += bw[j] * unpackHalf2x16(floatBitsToUint(fl[o]));
                gB += bw[j] * unpackHalf2x16(floatBitsToUint(fl[o + 1]));
                rA += bw[j] * unpackUnorm4x8(floatBitsToUint(fl[o + 2]));
                rB += bw[j] * unpackUnorm4x8(floatBitsToUint(fl[o + 3]));
            }
            gA *= fsc;
            gB *= fsc;
            const vec2 xp = vec2(p);
            const vec2 pAp = xp - t * gA, pAc = xp + (1.0 - t) * gA;
            const vec2 pBc = xp - (1.0 - t) * gB, pBp = xp + t * gB;
            V3WIn wi;
#if defined(V3L)
            float vAp, vAc, vBp, vBc;   // (hook (l): see v3Pair)
#endif
            vec3 soA, soB;
            float em0A, em0B;
            float hitA, hitB;
            v3Pair(pAp, pAc, nearT, wi.CAp, wi.CAc, soA, em0A, hitA V3L_ARG(vAp, vAc));
            v3Pair(pBp, pBc, nearT, wi.CBp, wi.CBc, soB, em0B, hitB V3L_ARG(vBp, vBc));
            // (tuning D3) an occluded hypothesis owns one frame only (A prev, B curr): that tap outside the frame is no source at all, so the hypothesis is a hole
            // (task 109) a hypothesis whose taps BOTH lie outside the picture (outside(): the 2 px ramp of edgeReject, in both frames: a vector
            // longer than the frame, or a large one near a corner) has no source at all: clamp-to-edge would read the frame's border texels (black with a
            // dark border). It is a hole too; the weight it keeps (both hypotheses far) goes to the zero-vector blend below (farW). A tap just past the edge
            // (content entering or leaving, edgeReject) is not touched: its partner is inside.
            const float farA = min(outside(pAp), outside(pAc)), farB = min(outside(pBp), outside(pBc));
            wi.oA = rA.x; wi.holeA = max(max(max(rA.y, hitA), rA.x * outsideFar(pAp)), farA); wi.uA = rA.z;
            wi.oB = rB.x; wi.holeB = max(max(max(rB.y, hitB), rB.x * outsideFar(pBc)), farB); wi.uB = rB.z;
            wi.t = t;
            wi.lenA = length(gA); wi.lenB = length(gB);
            V3WOut wo;
            v3Weights(wi, wo);
#if defined(V3B)
            // Settings::v3Blend (the -DV3B=1 build, V3.md 3.16 "As built (learned blend)"): the net's weights replace the rule's (mode bits 4..7: the variant 1 Fluidity, 2 Consistency); the
            // smear amount wo.s stays the rule's. wo.w is renormalised over the four taps and runs the path below unchanged; w4, w5 mix e0, e1 in after the smear.
            float bw4 = 0.0, bw5 = 0.0;
            float dw[4] = float[4](wo.w[0], wo.w[1], wo.w[2], wo.w[3]);
            const int bvar = (pc.mode >> 4) & 15;
            if (bvar != 0) v3BlendNet(wi, V3_LEVELS(s0.rgb), V3_LEVELS(s1.rgb), bvar, wo, bw4, bw5, dw);
#endif
            vec3 C = wo.w[0] * wi.CAp + wo.w[1] * wi.CAc + wo.w[2] * wi.CBp + wo.w[3] * wi.CBc;
            const float wA = wo.w[0] + wo.w[1], wB = wo.w[2] + wo.w[3];
            // (task 109) the plain time blend of the two real frames at the pixel: the fallback wherever the colour is not defined (never black, never a
            // texel of the frame's border)
            const vec3 blend0 = mix(V3_LEVELS(s0.rgb), V3_LEVELS(s1.rgb), t);   // (mix, not the static mask's own (1 - t) a + t c: sharing that expression changed how the compiler fuses it there, 1 level on one pixel)
            // the clamp box below is unset (lo > hi) only when neither hypothesis dominates, i.e. when wA / wB are NaN: clamping to it would turn the colour
            // into a finite black. Such a pixel, or one whose vectors are not finite, takes blend0 instead, before the clamp, and skips the smear.
            bool sane = all(lessThan(abs(vec4(gA, gB)), vec4(1e30)));
#if defined(V3L)
            // step 5 with hook (l): the detail split. Cs = sum w_i LP_i + sum d_i (C_i - LP_i) = C - sum (w_i - d_i) (C_i - LP_i), LP_i the 3x3 mean around the
            // tap (the same 9 texels as the clamp's box), d_i the detail shares: the sharpened weights (tilted to the later frame at a tie), the mass of a tap
            // whose value is not its own texels' (v3Pair's validity) given back to the plain weights. A tap with w_i = d_i needs no mean. Then the clamp as below.
            {
                vec3 lo = vec3(1e9), hi = vec3(-1e9);
                const bool clA = wA > wB - 0.25, clB = wB > wA - 0.25;
                const vec2 tp[4] = vec2[4](pAp, pAc, pBp, pBc);
                const vec3 ci[4] = vec3[4](wi.CAp, wi.CAc, wi.CBp, wi.CBc);
                const float vl[4] = float[4](vAp, vAc, vBp, vBc);
                float sc[4];
                float s0 = 0.0, sv = 0.0;
                for (int i = 0; i < 4; i++) {
                    sc[i] = v3Pow(wo.w[i] + ((i & 1) == 1 ? V3L_TILT : 0.0));
                    s0 += sc[i];
                    sv += sc[i] * vl[i];
                }
                vec3 corr = vec3(0.0);
                for (int i = 0; i < 4; i++) {
                    const bool needClamp = i < 2 ? clA : clB;
                    const float e = wo.w[i] - (sc[i] * vl[i] + (s0 - sv) * wo.w[i]) / s0;
                    const bool needLp = abs(e) * vl[i] > 1.0 / 256.0;
                    if (needClamp || needLp) {
                        vec3 mean;
                        v3BoxMean((i & 1) == 1, tp[i], needClamp, lo, hi, mean);
                        if (needLp) corr += (e * vl[i]) * (ci[i] - V3_LEVELS(mean));
                    }
                }
                sane = sane && all(lessThanEqual(lo, hi));
                C = sane ? clamp(C - V3L_GAIN * corr, V3_LEVELS(lo), V3_LEVELS(hi)) : blend0;
            }
#else
            // step 5: the pixel clamp, to the 3x3 neighbourhoods of the dominant hypothesis' taps (both where the weights are within 0.25)
            {
                vec3 lo = vec3(1e9), hi = vec3(-1e9);
                if (wA > wB - 0.25) { v3Box(false, pAp, lo, hi); v3Box(true, pAc, lo, hi); }
                if (wB > wA - 0.25) { v3Box(true, pBc, lo, hi); v3Box(false, pBp, lo, hi); }
                sane = sane && all(lessThanEqual(lo, hi));
                C = sane ? clamp(C, V3_LEVELS(lo), V3_LEVELS(hi)) : blend0;
            }
#endif
            // step 6: the smear along the motion where the estimate is unsure (no smear at all with v3Smear = 0)
            if (sane && pc.smear > 0.0 && wo.s > 1.0 / 16.0) {
                const float amt = 0.5 * pc.smear * wo.s;
                const float kA = min(1.0, 48.0 / max(wi.lenA * 2.0 * amt, 1e-3)), kB = min(1.0, 48.0 / max(wi.lenB * 2.0 * amt, 1e-3));   // |tau g| <= 48 px
                vec3 Cm = 3.0 * C;
                const float lat = V3_LAT * smoothstep(V3_LAT0, V3_LAT1, wo.s);
                for (int j = -2; j <= 2; j++) {
                    if (j == 0) continue;
                    const float tj = float(j) * amt;
                    const float tA = t + tj * kA, tB = t + tj * kB;
                    vec3 cAp, cAc, cBp, cBc, so_;
                    float e_;
                    float h_;
                    // (tuning 3) the 4 smear sets also sit on a plus of radius lat around the pixel: where the estimate is unsure the colour is low-passed across the motion too,
                    // so that no block edge of the vector field survives (taps of a hypothesis stay on its own line, shifted)
                    const vec2 xs = xp + lat * (((j + 2) & 1) == 0 ? vec2(float(j < 0 ? 1 : -1), 0.0) : vec2(0.0, float(j < 0 ? 1 : -1)));
                    const vec2 aP = xs - tA * gA, aC = xs + (1.0 - tA) * gA, bP = xs + tB * gB, bC = xs - (1.0 - tB) * gB;
                    v3Pair(aP, aC, nearT, cAp, cAc, so_, e_, h_ V3L_DUM);
                    v3Pair(bP, bC, nearT, cBp, cBc, so_, e_, h_ V3L_DUM);
                    {   // (task 109) a smear set whose two taps of a hypothesis both lie outside reads no border texel: that hypothesis' share is the blend
                        const float fA = min(outside(aP), outside(aC)), fB = min(outside(bP), outside(bC));
                        if (fA > 0.0) { cAp = mix(cAp, blend0, fA); cAc = mix(cAc, blend0, fA); }
                        if (fB > 0.0) { cBp = mix(cBp, blend0, fB); cBc = mix(cBc, blend0, fB); }
                    }
                    Cm += (3.0 - abs(float(j))) * (wo.w[0] * cAp + wo.w[1] * cAc + wo.w[2] * cBp + wo.w[3] * cBc);
                }
                C = mix(C, Cm * (1.0 / 9.0), smoothstep(0.05, 0.5, wo.s));
            }
            // (task 109) the weight still on hypotheses whose taps both lie outside (both hypotheses outside: all of it) takes the zero-vector blend of the
            // two real frames at the pixel, not a mix of border texels
            {
                const float farW = wA * farA + wB * farB;
                if (farW > 0.0) C = mix(C, blend0, farW);
            }
#if defined(V3B)
            if (bvar != 0) C = (1.0 - bw4 - bw5) * C + bw4 * V3_LEVELS(s0.rgb) + bw5 * V3_LEVELS(s1.rgb);   // the six-choice net's two extra choices: prev(x), curr(x)
#endif
            // step 7: the static mask
            float wst = 0.0;
            if (nearS || nearT) {
                const vec3 sa = V3_LEVELS(s0.rgb), sc = V3_LEVELS(s1.rgb);
                const vec3 dA = V3_D(wi.CAp, wi.CAc), dB = V3_D(wi.CBp, wi.CBc);
                const float em = wA * max(dA.r, max(dA.g, dA.b)) + wB * max(dB.r, max(dB.g, dB.b));
                const float em0 = wA * em0A + wB * em0B;
                wst = v3StaticWeight(p, sbits, sa, sc, em, em0, wA * soA + wB * soB);
                C = mix(C, (1.0 - t) * sa + t * sc, wst);
            }
            if ((pc.mode & V3M_DUMP) != 0 && p.y * pc.W + p.x < pc.lw * pc.lh && (p.y * pc.W + p.x) % pc.lw == 0) {
                // the 28-float record of the weight stage (V3.md 3.16): inputs, sigma (the static weight), outputs
                const int rec = pc.fdOff + 8 * N + pc.lvl * 4 * N + 28 * ((p.y * pc.W + p.x) / pc.lw);
                const vec3 cc[4] = vec3[4](wi.CAp, wi.CAc, wi.CBp, wi.CBc);
                for (int i = 0; i < 4; i++) { fl[rec + 3 * i] = cc[i].x; fl[rec + 3 * i + 1] = cc[i].y; fl[rec + 3 * i + 2] = cc[i].z; }
                const float sc_[10] = float[10](wi.oA, wi.holeA, wi.uA, wi.oB, wi.holeB, wi.uB, t, wi.lenA, wi.lenB, wst);
                for (int i = 0; i < 10; i++) fl[rec + 12 + i] = sc_[i];
#if defined(V3B)
                // (v3Blend: the net's weights; the four tap weights before the renormalisation, and w4 + w5 in the pad)
                fl[rec + 22] = dw[0]; fl[rec + 23] = dw[1]; fl[rec + 24] = dw[2]; fl[rec + 25] = dw[3]; fl[rec + 26] = wo.s; fl[rec + 27] = bw4 + bw5;
#else
                fl[rec + 22] = wo.w[0]; fl[rec + 23] = wo.w[1]; fl[rec + 24] = wo.w[2]; fl[rec + 25] = wo.w[3]; fl[rec + 26] = wo.s; fl[rec + 27] = 0.0;
#endif
            }
            // (task 107) the synthesis never stores a non-finite value (a UNORM store turns a NaN into black): where the colour is undefined the pixel is the
            // plain time blend of the two real frames at t. Nothing in the tested range reaches it (the output is byte-identical with the line removed).
            if (any(isnan(C)) || any(isinf(C))) C = blend0;
            v = V3_QUANT(C);
            a = mix(s0.a, s1.a, t);
        }
        acc += w * v;
        accA += w * a;
        ws += w;
    }
#if defined(FG_YUV)
    // the Y plane at p; the CbCr plane by the even-even pixel of each 2x2 block (as v2_morph.glsl: its taps sit at the block centre)
    imageStore(outImg, p, vec4(fgOut(acc.x / ws), 0.0, 0.0, 1.0));
    if (((p.x | p.y) & 1) == 0) imageStore(outImgC, p >> 1, vec4(fgOut2(acc.yz / ws), 0.0, 1.0));
#elif defined(FG_FORMAT_F16)
    imageStore(outImg, p, FG_STORE(v3Half(acc / ws), accA / ws));   // rounded to the nearest half here, as the sub-frames' V3_QUANT
#else
    imageStore(outImg, p, FG_STORE(acc / ws, accA / ws));
#endif
}
