#version 450
#extension GL_GOOGLE_include_directive : require
// V2 (both modes), the static-structure mask S (flow resolution, once per estimate, beside the block re-pick: it reads only the
// luma), see v2_motion.glsl: where both real frames show the same STRUCTURE at a place, whatever changes behind it. Per flow pixel
// m, over its 4 neighbours n: the gradients ga = a(m) - a(n) and gc = c(m) - c(n) of prev's and curr's luma; the structure agrees
// when sum |ga - gc| is small against sum max(|ga|, |gc|). That is the zero vector's mismatch with its local mean removed, so a
// semi-transparent overlay (a damage panel, HUD text, chat) whose background moves and changes its brightness still agrees, while
// a moving texture does not (its gradients at m change with the content). Flat places carry no evidence (the structure term ramps in
// over S_D0 .. S_D0 + S_D1 levels). A lone agreeing pixel (a moving texture that happens to match) is dropped: at least 2 of its 8
// neighbours must agree as well (strokes of text, edges of a HUD element are lines).
// Writes S (float bits) to qb[sOff() + m] and, per 8x8 cell, its largest S if enough of it is in the mask (the input of
// v2_enclose.comp) to qb[s8Off() + cell].
#include "common.glsl"
#include "v2_motion.glsl"
layout(local_size_x = 16, local_size_y = 16) in;

const float S_EPS = 8.0;              // luma levels: a flat place's ratio stays high
const float S_R0 = 0.2, S_R1 = 0.4;   // ratio of the gradient mismatch to the gradients: <= R0 -> 1, >= R1 -> 0
const float S_D0 = 16.0, S_D1 = 24.0; // sum of the 4 gradient magnitudes (levels): structure from D0, full at D0 + D1
const float S_CELL = 4.0;             // pixels of an 8x8 cell in the mask that make it count (v2_enclose.comp)
const float S_L0 = 8.0, S_L1 = 16.0;  // sum of the second differences (levels, the smaller frame's): an edge from L0, full at L0 + L1

const int TS = 16, TR = TS + 2, TL = TS + 4;   // tile; raw with a 1 px apron; the luma it reads with 2
shared float raw[TR * TR];
shared uint cmax[4], ccnt[4];
shared float la[TL * TL], lc_[TL * TL];

float rawAt(int x, int y) {   // (x, y): the flow pixel's place in la / lc_
    int i = y * TL + x;
    float a0 = la[i], c0 = lc_[i];
    float num = 0.0, den = 0.0;
    const int o[4] = int[4](1, -1, TL, -TL);
    float ga[4], gc[4];
    for (int k = 0; k < 4; k++) {
        ga[k] = a0 - la[i + o[k]];
        gc[k] = c0 - lc_[i + o[k]];
        num += abs(ga[k] - gc[k]);
        den += max(abs(ga[k]), abs(gc[k]));
    }
    float r = num / (den + S_EPS);
    // ... and is an edge, not a ramp: a smooth gradient that moves keeps its slope too (shifted, a linear ramp looks the same), so
    // the structure must also bend (the sum of the second differences along x and y, in both frames: a stroke, a step)
    float lap = min(abs(ga[0] + ga[1]) + abs(ga[2] + ga[3]), abs(gc[0] + gc[1]) + abs(gc[2] + gc[3]));
    return clamp((S_R1 - r) * (1.0 / (S_R1 - S_R0)), 0.0, 1.0) * clamp((den - S_D0) * (1.0 / S_D1), 0.0, 1.0) *
           clamp((lap - S_L0) * (1.0 / S_L1), 0.0, 1.0);
}

void main() {
    int lid = int(gl_LocalInvocationIndex);
    ivec2 t0 = ivec2(gl_WorkGroupID.xy) * TS;
    int N = pc.fw * pc.fh;
    for (int i = lid; i < TL * TL; i += TS * TS) {   // the luma of the tile with a 2 px apron, clamp to edge
        ivec2 m = clamp(t0 - 2 + ivec2(i % TL, i / TL), ivec2(0), ivec2(pc.fw - 1, pc.fh - 1));
        la[i] = luma[m.y * pc.fw + m.x];
        lc_[i] = luma[N + m.y * pc.fw + m.x];
    }
    barrier();
    for (int i = lid; i < TR * TR; i += TS * TS) {
        int x = i % TR, y = i / TR;
        ivec2 m = t0 - 1 + ivec2(x, y);
        bool in_ = all(greaterThanEqual(m, ivec2(0))) && all(lessThan(m, ivec2(pc.fw, pc.fh)));
        raw[i] = in_ && pc.fIn == 0 ? rawAt(x + 1, y + 1) : 0.0;   // fIn = 1: Settings::v2StaticMask off (an empty mask)
    }
    barrier();
    ivec2 lc = ivec2(gl_LocalInvocationID.xy);
    ivec2 l = lc + 1;
    float n = 0.0;
    for (int j = -1; j <= 1; j++)
        for (int i = -1; i <= 1; i++)
            if (i != 0 || j != 0) n += raw[(l.y + j) * TR + l.x + i] >= 0.5 ? 1.0 : 0.0;
    float s = raw[l.y * TR + l.x] * clamp(n - 1.0, 0.0, 1.0);
    ivec2 m = ivec2(gl_GlobalInvocationID.xy);
    if (m.x >= pc.fw || m.y >= pc.fh) s = 0.0;
    else qb[sOff() + m.y * pc.fw + m.x] = floatBitsToUint(s);
    // per 8x8 cell (v2_enclose.comp's input): the largest S, if at least S_CELL of its pixels are in the mask (a stroke, an edge of
    // a HUD element; not a stray match or two of a moving texture), else 0
    int cell = (lc.y >> 3) * 2 + (lc.x >> 3);
    if (lid < 4) { cmax[lid] = 0u; ccnt[lid] = 0u; }
    barrier();
    if (s > 0.0) atomicMax(cmax[cell], floatBitsToUint(s));   // (S >= 0: its bits order as the values)
    if (s >= 0.5) atomicAdd(ccnt[cell], 1u);
    barrier();
    if (lid < 4) {
        ivec2 c = ivec2(gl_WorkGroupID.xy) * 2 + ivec2(lid & 1, lid >> 1);
        if (c.x < s8W() && c.y < s8H()) qb[s8Off() + c.y * s8W() + c.x] = float(ccnt[lid]) >= S_CELL ? cmax[lid] : 0u;
    }
}
