#version 450
#extension GL_GOOGLE_include_directive : require
// V2, estimate (flow res, after v2_occl; the occlusion gate, I12, Settings::v2OccGate): gives a clean occlusion back to V1's output
// where its surroundings are HELD. A real occlusion strip lies between two regions that its two vectors explain (both sides are
// trusted: the background on one, the foreground on the other); a "clean occlusion" inside a region the field does not explain at
// all is noise of a field that is wrong there: a muzzle flash or an explosion (the next frame's colour over the whole view; luma-only
// matching pairs grey with orange of the same luma and gives confident garbage vectors), tracer streaks over a held region. Its
// one-sided warp (and the candidate pick, which blends in the same frame's colour) then paints blotchy, hard-edged patches of one
// frame into V1's soft hold (battlefield f43 / f263 / f363 flashes, f81 tracer specks: the round-1 blind test's losses to V1).
//
// Per flow pixel q with a clean occlusion (v2_occl.comp side != 0): over the pixels WITHOUT one within AG = 12 flow px (a 13 x 13
// lattice of every second pixel: +-24 full-resolution px at flowScale 2), the share hs that is held (v2_occl.comp's statistics: the
// 3x3 mean colour mismatch of the pixel's own vector at full resolution at or above the middle of the trust ramp). The gate weight
// G = ramp(hs, 0.6 .. 0.85) x strength (PC2 occ0 = V2Knobs occGate in this pass); with fewer than 8 such pixels in the window
// (the middle of a wide strip) nothing decides and G = 0. G = 1: the occlusion is dropped (side 0: V1's trusted / held output and
// no candidate pick); 0 < G < 1: stored in the occlusion map's w, bits 4-7 (x 15), and the resolve fades the pixel's clean-occlusion
// output (one-sided warp AND candidate pick) towards V1's by G (v2_resolve_core.glsl: the occlusion share tg).
// Measured on the sites (I12, preset D): it removes the flash patches (battlefield k21 / k131 / k181) and most tracer specks (k40)
// and changes no pixel by more than 8 levels at three racing_forza6_b sites (fences, poles), a few hundred at the Minecraft trunks.
// A test of the brightness change (the mean colour c - a of the surrounding pixels, ramp 8 .. 16 levels) was tried as well and never
// fired at the flash sites: their surroundings are held (wrong vectors), not explained with a brightness bias. The held share alone
// removes the flash patches and the tracer specks.
// Reads the statistics (v2_temporal.glsl v2GOff(), written by v2_occl.comp); writes only q's own occlusion-map entry (side, w).
#include "common.glsl"
#include "motion_v2.glsl"
#include "v2_temporal.glsl"
layout(local_size_x = 16, local_size_y = 16) in;

#define GATE_STRENGTH pc.occ0   // (estimate: occ0 is the synth's occlusion ramp, unused here)
const float HS0 = 0.6, HS1 = 0.85;

const int TS = 16, AG = 12, NL = TS / 2 + AG + 1;   // the lattice: the even flow pixels of the tile + AG (NL x NL)
const int NW = TS / 2 + 1;                           // the distinct windows per axis (a pair of pixels shares one)
shared uint sw[NL * NL];   // per lattice pixel: 1 + 65536 x held if it has no clean occlusion, else 0 (and outside the frame)
shared uint sh[NL * NW];   // horizontal 13-sums
shared uint sv[NW * NW];   // the window sums: low 16 bits the pixels without a clean occlusion, high 16 the held ones of them
shared uint anyOcc;

void main() {
    int lid = int(gl_LocalInvocationIndex);
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    int go = v2GOff();
    bool inside = q.x < pc.fw && q.y < pc.fh;
    uint own = inside ? v2b[go + q.y * pc.fw + q.x] : 0u;
    if (lid == 0) anyOcc = 0u;
    barrier();
    if ((own & 3u) != 0u) atomicOr(anyOcc, 1u);
    barrier();
    if (anyOcc == 0u) return;   // (uniform: most tiles have no clean occlusion)
    // the window of q: the even flow pixels within +-AG of it (13 x 13; for an odd q the last row / column is q + AG + 1), from the
    // lattice of the even pixels of the tile + AG (the same for every q of the tile), summed separably
    ivec2 t0 = ivec2(gl_WorkGroupID.xy) * TS - AG;   // even (TS, AG even)
    for (int i = lid; i < NL * NL; i += TS * TS) {
        ivec2 y = t0 + 2 * ivec2(i % NL, i / NL);
        uint w = all(lessThan(y, ivec2(pc.fw, pc.fh))) && all(greaterThanEqual(y, ivec2(0))) ? v2b[go + y.y * pc.fw + y.x] : 3u;
        sw[i] = (w & 3u) == 0u ? 1u + ((w & 4u) << 14) : 0u;
    }
    barrier();
    if (lid < NL * NW) {
        int r = lid / NW, c = lid % NW;
        uint a = 0u;
        for (int k = 0; k <= AG; k++) a += sw[r * NL + c + k];
        sh[lid] = a;
    }
    barrier();
    if (lid < NW * NW) {
        int r = lid / NW, c = lid % NW;
        uint a = 0u;
        for (int k = 0; k <= AG; k++) a += sh[(r + k) * NW + c];
        sv[lid] = a;
    }
    barrier();
    if ((own & 3u) == 0u) return;   // no clean occlusion at q (also outside the frame)
    ivec2 c0 = (ivec2(gl_LocalInvocationID.xy) + 1) >> 1;   // q's window: lattice columns / rows c0 .. c0 + AG
    uint v = sv[c0.y * NW + c0.x];
    int nN = int(v & 0xFFFFu), nH = int(v >> 16);
    float hs = nN >= 8 ? float(nH) / float(nN) : 0.0;
    float G = clamp((hs - HS0) * (1.0 / (HS1 - HS0)), 0.0, 1.0) * GATE_STRENGTH;
    uint g4 = uint(roundEven(G * 15.0));
    if (g4 == 0u) return;
    int i = 4 * (q.y * pc.fw + q.x);
    if (g4 >= 15u) v2b[i + 2] = 0u;
    else v2b[i + 3] |= g4 << 4;
}
