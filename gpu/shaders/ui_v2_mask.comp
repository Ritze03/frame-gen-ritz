#version 450
#extension GL_GOOGLE_include_directive : require
// CrosshairV2, observe, box: the mask of the box, from the state ui_v2_update.comp just wrote. A pixel is "confirmed"
// if it is in the mask or within 1 px (8-neighbourhood, a hard grow, no feather) of one; the byte is
//   255  confirmed AND unchanged in this pair (max channel |curr - prev| <= thr): ui_patch pastes the real pixel (the pair gate)
//    64  confirmed but it changed in this pair: not pasted; still treated as UI by the motion estimate (ui_v2_lumafill.comp)
//     0  not UI
// One thread per 4 pixels (one mask word), the layout of ui_box_mask.comp. Thread (0, 0) also writes the rectangle into the header
// words [1..3] (V2 never uses [0]): the synthesis passes read it to reject warp taps that land on the UI (ui_reject.glsl).
// The mask rectangle (pc.mask*) is the box grown by 1 px (clamped to the frame), and the state is laid out over it (see
// ui_v2_update.comp): only pixels inside the box are ever in the mask, so the 1 px ring around the box is exactly the grow of
// a mask pixel on the box edge; its pair gate comes from the state the ring pixels keep.
#include "ui_common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;

uint flagsAt(ivec2 p) {
    if (p.x < 0 || p.y < 0 || p.x >= pc.maskW || p.y >= pc.maskH) return 0u;
    return st[(p.y * pc.maskW + p.x) * 4 + 1] >> 24;
}

void main() {
    ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    if (g.x >= pc.maskStride || g.y >= pc.maskH) return;
    uint word = 0u;
    for (int k = 0; k < 4; k++) {
        ivec2 p = ivec2(g.x * 4 + k, g.y);
        if (p.x >= pc.maskW) break;
        bool near = false;
        for (int y = -1; y <= 1; y++)
            for (int x = -1; x <= 1; x++)
                near = near || (flagsAt(p + ivec2(x, y)) & 1u) != 0u;
        uint a = 0u;
        if (near) a = (flagsAt(p) & 4u) != 0u ? 255u : 64u;
        word |= a << uint(8 * k);
    }
    mk[pc.maskOff + g.y * pc.maskStride + g.x] = word;
    if (g == ivec2(0)) {   // the rectangle of the mask, for the warp passes' tap rejection (ui_reject.glsl)
        mk[1] = uint(pc.maskX) | (uint(pc.maskY) << 16);
        mk[2] = uint(pc.maskW) | (uint(pc.maskH) << 16);
        mk[3] = uint(pc.maskStride);
    }
}
