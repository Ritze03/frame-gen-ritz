#version 450
#extension GL_GOOGLE_include_directive : require
// MotionVersion::V3, Settings::v3Motion = 1 (V3.5, round 1): confidence-weighted regularisation of one level's block field. One Jacobi step: reads the block records of
// slot pc.iter (a) of level pc.lvl and writes slot 1 - a (the level below the top runs it twice, a -> b and b -> a; every other level once, its result then stays in slot 1 - a and
// the search below reads its parent's records from there: v3_search_35 with mode bit 1). The mode bits M35_CW / M35_CR (below) pass the blocks' static data from a level's first step to its second. Dispatch: tiles of 8x8 blocks,
// ceil(gw / 8) x ceil(gh / 8) x 2 (z = direction), workgroup 64, one block per thread; the tile and a 2-block apron are staged in shared memory.
// What a block's own search proves: its texture, from the structure tensor of the high-pass features over the block (sqrt of its two eigenvalues: r1 along the
// dominant gradient n, r2 along the other direction t), times how well it matched (cost relative to the texture) and the level's ambiguity measure. A flat road or sky
// proves nothing (the search tied and took the inherited vector or zero), a lane marking or any straight edge proves the motion across it (n) and nothing along it (t:
// the aperture problem; the search leaves the along-the-line part at its bias, often zero), a corner or texture proves both.
// The consensus of the 5x5 neighbours: the weighted medoid of their vectors (weight = their two-dimensional confidence x colour similarity to this block x distance),
// refined by two mean-shift steps; a flat block between a still object and a moving road thereby takes the larger confident group of its own colour. The block becomes
//   v' = consensus + n ra' (n . (own - consensus)) + t rb' (t . (own - consensus))
// (ra', rb' = how far its own vector is believed along each axis), so a confident block is left alone, a flat one takes the consensus and a line keeps what crosses it.
// Without confident neighbours the camera model (once v3_stats has fitted it: the levels below the stats level) is the consensus. Records keep (vx, vy, cost, amb).
#include "common.glsl"
#include "v3_common.glsl"
#include "v3_est.glsl"
#include "v35_cam.glsl"
layout(local_size_x = 8, local_size_y = 8) in;

const vec2 G01 = vec2(0.6, 2.5);      // sqrt(eigenvalue / pixels) of the structure tensor (feature levels per px): confidence ramp
const vec2 CR = vec2(1.0, 2.5);       // cost / (texture + 2): a block matching worse than this ratio proves less
const vec2 REJ = vec2(0.0, -0.03);       // a replacement is kept only when its window cost is at least 3% lower than the old vector's: where the image has no evidence for the change (a flat block, a still object's rim) the block keeps its own vector
const vec2 REJ2 = vec2(0.05, 0.02);     // the same for the outlier rule (R2): the model's vector must match nearly as well as the block's
const float COLS = 12.0;              // colour distance (L1 over Y Cb Cr) at which the vote weight is 1/e
const float WCAM = 0.6;               // the camera model's vote when there are no confident neighbours (fades out as their weight grows to 1.5)
const float MODEL_SUP = 0.3;          // a block whose vector fewer than this share of the neighbour weight supports takes the model's (when the window agrees)
const int M35_CW = 1 << 21;           // the first of a level's two steps: also writes the blocks' static data for the second
const int M35_CR = 1 << 22;           // the second step: reads that data instead of computing it again
const int M35_L0 = 1 << 20;          // level 0's single pass: reads slot 0, writes only the vector of slot 1
const float AP_R1 = 0.6, AP_R2 = 0.15;   // an edge-only block: strong structure along one direction only
const float HUD_EN = 2.0;             // the HUD hold (below): a block with at least this much detail (mean v3Detail; a flat block matches every vector and proves nothing)
const float MMIN = 0.15;              // the summed weight below which a block keeps its vector

shared vec4 srec[144];      // record (vx, vy, cost, amb) of the tile's blocks with the apron
shared vec4 scol[144];      // block mean colour (Y, Cb, Cr) and the vote weight (two-dimensional confidence)
shared vec4 sax[144];       // n.x, n.y, ra', rb'
shared int sok[144];
shared float sr1[144];      // the block's own texture along its dominant gradient (0 = flat)
shared float sen[144];      // the block's mean detail (v3Detail of the features): the evidence of the HUD hold below

vec3 rawAt(const V3Lv L, int f, ivec2 p) {
    p = clamp(p, ivec2(0), ivec2(L.w - 1, L.h - 1));
    const uvec2 t = pyr[2 * L.off + f * L.w * L.h + p.y * L.w + p.x];
    return vec3(unpackHalf2x16(t.x), unpackHalf2x16(t.y).x);
}

// the weighted feature channels' gradient at x (central differences, clamped)
vec4 featAt(const V3Lv L, int fOff, int f, ivec2 p) { return v3FeatC(L, fOff, f, p); }

// the matching cost (v3Term over the window of the search: 8 x 8, with a 2 px apron above level 0) of block b at vector v (level px, sub-pixel)
float winCost(const V3Lv L, int fOff, int dir, ivec2 b, vec2 v) {
    const vec2 dMu = v3DMu(dir);
    const ivec2 wo = pc.lvl == 0 ? b * 8 : b * 4 - 2;
    float s = 0.0, n = 0.0;
    const vec2 mx = vec2(float(L.w - 1), float(L.h - 1));
    for (int k = 0; k < 16; k++) {   // every second pixel of the window (a flat or textured block alike: the comparison between vectors is what counts)
        const ivec2 x = wo + ivec2(2 * (k & 3), 2 * (k >> 2));
        const vec2 q = vec2(x) + v;
        // (branch-free: every sample's loads are issued together, the invalid ones add exactly 0)
        const bool ok = x.x >= 0 && x.y >= 0 && x.x < L.w && x.y < L.h && q.x >= 0.0 && q.y >= 0.0 && q.x <= mx.x && q.y <= mx.y;
        const float t = v3Term(v3FeatC(L, fOff, dir, x), v3FeatBil(L, fOff, 1 - dir, q), dMu);
        s += ok ? t : 0.0;
        n += ok ? 1.0 : 0.0;
    }
    return n >= 8.0 ? s / n : 255.0;
}

void main() {
    const int dir = int(gl_WorkGroupID.z);
    const int lid = int(gl_LocalInvocationIndex);
    const int l = pc.lvl;
    const V3Lv L = v3Lv(l);
    int P, Bw, nLev;
    v3Totals(P, Bw, nLev);
    const int fOff = 2 * P;
    const int sa = pc.iter, sb = 1 - sa;
    const ivec2 org = ivec2(gl_WorkGroupID.xy) * 8 - 2;
    const int bs = l == 0 ? 8 : 4;
    for (int idx = lid; idx < 144; idx += 64) {
        const ivec2 b = org + ivec2(idx % 12, idx / 12);
        const bool ok = all(greaterThanEqual(b, ivec2(0))) && all(lessThan(b, ivec2(L.gw, L.gh)));
        sok[idx] = ok ? 1 : 0;
        if (!ok) { sen[idx] = 0.0; srec[idx] = vec4(0.0); scol[idx] = vec4(0.0); sax[idx] = vec4(1.0, 0.0, 0.0, 0.0); sr1[idx] = 0.0; continue; }
        const int o = v3BlkIdx(L, dir, sa, b);
        const vec4 r = vec4(fl[o], fl[o + 1], fl[o + 2], fl[o + 3]);
        srec[idx] = r;
        float r1, r2, en;
        vec2 nv;
        // the block's static data (12 floats, independent of the vectors) in the FD region of V3B_FLOW (free until v3_dense): the first step of a level writes it for its own tile, the second reads it
        const int so = pc.fdOff + (L.blk * 3) / 2 + (dir * L.gw * L.gh + b.y * L.gw + b.x) * 12;
        if ((pc.mode & M35_CR) != 0) {
            scol[idx] = vec4(fl[so], fl[so + 1], fl[so + 2], fl[so + 3]);
            nv = vec2(fl[so + 4], fl[so + 5]);
            r1 = fl[so + 6]; r2 = fl[so + 7];
            sax[idx] = vec4(nv, fl[so + 8], fl[so + 9]);
            en = fl[so + 10];
            sr1[idx] = r1;
            sen[idx] = en;
        } else {
        // the block's pixels (4 x 4 samples at stride bs / 4): colour, detail, structure tensor of the weighted channels
        const ivec2 x0 = b * bs;
        const int st = bs / 4;
        float n = 0.0, gxx = 0.0, gxy = 0.0, gyy = 0.0;
        en = 0.0;
        vec3 col = vec3(0.0);
        for (int j = 0; j < 4; j++)
            for (int i = 0; i < 4; i++) {
                const ivec2 x = x0 + ivec2(i, j) * st;
                if (x.x >= L.w || x.y >= L.h) continue;
                const vec4 f0 = featAt(L, fOff, dir, x);
                en += v3Detail(f0);
                col += rawAt(L, dir, x);
                const vec4 dx = featAt(L, fOff, dir, x + ivec2(1, 0)) - featAt(L, fOff, dir, x - ivec2(1, 0));
                const vec4 dy = featAt(L, fOff, dir, x + ivec2(0, 1)) - featAt(L, fOff, dir, x - ivec2(0, 1));
                const vec3 w3 = V3_CW.xyz;
                gxx += dot(w3 * dx.xyz, dx.xyz); gxy += dot(w3 * dx.xyz, dy.xyz); gyy += dot(w3 * dy.xyz, dy.xyz);
                n += 1.0;
            }
        en /= max(n, 1.0);
        col /= max(n, 1.0);
        const float inv = 0.25 / max(n, 1.0);   // (central differences span 2 px: /2, squared: /4)
        gxx *= inv; gxy *= inv; gyy *= inv;
        const float tr = gxx + gyy, df = sqrt(max(0.25 * (gxx - gyy) * (gxx - gyy) + gxy * gxy, 0.0));
        const float l1 = 0.5 * tr + df, l2 = max(0.5 * tr - df, 0.0);
        // principal direction (the larger eigenvalue's eigenvector)
        nv = abs(gxy) > 1e-9 ? normalize(vec2(l1 - gyy, gxy)) : (gxx >= gyy ? vec2(1.0, 0.0) : vec2(0.0, 1.0));
        r1 = smoothstep(G01.x, G01.y, sqrt(l1)); r2 = smoothstep(G01.x, G01.y, sqrt(l2));
        const float bconf = (1.0 - smoothstep(CR.x, CR.y, r.z / (en + 2.0))) * (1.0 - 0.7 * r.w);
        scol[idx] = vec4(col, bconf * max(r2, 0.15 * r1));
        sr1[idx] = r1;
        sen[idx] = en;
        sax[idx] = vec4(nv, smoothstep(0.05, 0.45, r1), smoothstep(0.05, 0.45, r2));
        if ((pc.mode & M35_CW) != 0) {
            const ivec2 lq = ivec2(idx % 12, idx / 12);
            if (all(greaterThanEqual(lq, ivec2(2))) && all(lessThan(lq, ivec2(10)))) {   // (the tile's own blocks)
                fl[so] = col.x; fl[so + 1] = col.y; fl[so + 2] = col.z; fl[so + 3] = scol[idx].w;
                fl[so + 4] = nv.x; fl[so + 5] = nv.y; fl[so + 6] = r1; fl[so + 7] = r2;
                fl[so + 8] = sax[idx].z; fl[so + 9] = sax[idx].w; fl[so + 10] = en;
            }
        }
        }
        if (l > 1 && r1 > AP_R1 && r2 < AP_R2) {
            // the aperture problem: an edge-only block measured its motion across the edge only; along the edge its vector is whatever the search propagated. Along the edge it takes
            // the camera model's vector (the across-edge part stays), where the window agrees (a still object's outline, parallax: it keeps its own). Before the vote, so
            // that the block does not vote its wrong along-edge part into the flat surface beside it.
            vec2 m; float mq0 = 1.0;
            bool hm = regVote(L, l, dir, b, m, mq0);
            if (!hm) { hm = camVote(L, l, dir, b, m); mq0 = 1.0; }
            if (hm && mq0 > 0.5) {
                const vec2 tv = vec2(-nv.y, nv.x);
                const vec2 rr = r.xy + tv * dot(m - r.xy, tv);
                if (length(rr - r.xy) > 0.5) {
                    const float c0 = winCost(L, fOff, dir, b, r.xy), c1 = winCost(L, fOff, dir, b, rr);
                    if (c1 <= c0 + 0.05 + 0.1 * c0) srec[idx].xy = rr;
                }
            }
        }
    }
    barrier();
    const ivec2 lp = ivec2(lid & 7, lid >> 3);
    const ivec2 b = ivec2(gl_WorkGroupID.xy) * 8 + lp;
    if (b.x >= L.gw || b.y >= L.gh) return;
    const int ci = (lp.y + 2) * 12 + lp.x + 2;
    const vec4 own = srec[ci];
    // the HUD hold (hudBonus > 0, task 160): V3's block search keeps the zero vector of a block that a static overlay explains (the bonus acts on evidence: the zero vector matches, the
    // window has detail, the moving vector is a real motion); a thin still line (a reticle, a rule) in moving surroundings owns only a few pixels of its block, so the window test
    // below would still call the background's vector no worse, and the vote, the neighbours and the model would take the line along. A block that has the zero vector and detail keeps it.
    // (Before: v3test --scene hud overlay error 9.2 / 9.4 levels against V3's 6.1 / 6.4, limit 7; the reticle took the background's vector at level 1.)
    const bool holdOwn = pc.hudB > 0.0 && length(own.xy) < 0.25 && sen[ci] >= HUD_EN;
    // neighbour votes
    float w[26];
    vec2 v[26];
    float mass = 0.0;
    for (int k = 0; k < 25; k++) {
        const ivec2 d = ivec2(k % 5 - 2, k / 5 - 2);
        const int ni = (lp.y + 2 + d.y) * 12 + lp.x + 2 + d.x;
        v[k] = srec[ni].xy;
        float ww = 0.0;
        if (sok[ni] != 0 && k != 12) {
            const vec3 dc = abs(scol[ni].xyz - scol[ci].xyz);
            ww = scol[ni].w * exp(-(dc.x + dc.y + dc.z) * (1.0 / COLS)) * (max(abs(d.x), abs(d.y)) == 1 ? 1.0 : 0.5);
        }
        w[k] = ww;
        mass += ww;
    }
    v[25] = vec2(0.0);
    w[25] = 0.0;
    float mq = 1.0;   // the model's reliability here (regional: v35_rgn's residual measure; the global camera: 1)
    bool hasM = regVote(L, l, dir, b, v[25], mq);
    if (!hasM) { hasM = camVote(L, l, dir, b, v[25]); mq = 1.0; }
    float mass0 = mass;
    if (hasM) {
        // a flat block trusts the camera model by its quality; the neighbours that agree with the model then count more, those that do not (a still car beside a zooming
        // road, a different object) less, so that the road next to the car follows the road
        const float cq = (1.0 - smoothstep(0.1, 0.6, sr1[ci])) * mq;
        const float tol = max(1.0, 0.2 * length(v[25]));
        mass = 0.0;
        for (int k = 0; k < 25; k++) {
            if (w[k] <= 0.0) continue;
            w[k] *= mix(1.0, length(v[k] - v[25]) < tol ? 1.6 : 0.4, cq);
            mass += w[k];
        }
        mass0 = mass;
        w[25] = WCAM * cq * (1.0 - smoothstep(0.3, 1.5, mass));
    }
    mass += w[25];
    vec2 res = own.xy;
    float cRes = -1.0;   // the window cost at res when it is known (the check below computed it)
#ifdef V35_DIAG
    vec2 vRes = own.xy;
    bool r2Eval = false, r2Sup = false, r2Cost = false;
#endif
    if (mass >= MMIN && !holdOwn) {
        // the weighted medoid
        int bi = 12;
        float bc = 1e9;
        for (int a = 0; a < 26; a++) {
            if (w[a] <= 0.0) continue;
            float c = 0.0;
            for (int k = 0; k < 26; k++) c += w[k] * min(length(v[a] - v[k]), 3.0);
            if (c < bc) { bc = c; bi = a; }
        }
        vec2 x = v[bi];
        for (int it = 0; it < 2; it++) {
            const float sg = 0.8 + 0.1 * length(x);
            vec2 s = vec2(0.0);
            float sw = 0.0;
            for (int k = 0; k < 26; k++) {
                if (w[k] <= 0.0) continue;
                const vec2 dd = (v[k] - x) / sg;
                const float g = w[k] * exp(-dot(dd, dd));
                s += g * v[k];
                sw += g;
            }
            if (sw > 1e-6) x = s / sw;
        }
        const vec4 a4 = sax[ci];
        const vec2 nv = a4.xy, tv = vec2(-nv.y, nv.x);
        const vec2 dlt = own.xy - x;
        res = x + nv * (a4.z * dot(dlt, nv)) + tv * (a4.w * dot(dlt, tv));
#ifdef V35_DIAG
        vRes = res;
#endif
        // the check against the image: the change is kept only where the new vector explains the block's window about as well as the old one (a flat block: equally well; a
        // textured block whose own vector is right, a thin or fast object, parallax: clearly worse, it keeps its own)
        if (dot(res - own.xy, res - own.xy) > 1e-6) {
            const float c0 = winCost(L, fOff, dir, b, own.xy), c1 = winCost(L, fOff, dir, b, res);
            if (c1 > c0 + REJ.x + REJ.y * c0) { res = own.xy; cRes = c0; } else cRes = c1;
        }
    }
    if (hasM && mq > 0.5 && length(res - v[25]) > 0.5 && !(holdOwn && length(v[25]) * exp2(float(l)) * float(pc.fscale) >= pc.hp[3])) {
        // the model decides where a confident block is not supported by its neighbours (a repeat of the texture matched at the wrong place: window grids, signs): it takes
        // the model's vector when its window matches there nearly as well as at the vector it has now (a textured block whose own vector is right matches clearly worse at the
        // model's: it keeps its own). Flat blocks follow their confident neighbours of their colour in the vote above, not this rule (a still object's flat body).
        float sup = 0.0;
        const float tolS = 1.0 + 0.1 * length(res);
        for (int k = 0; k < 25; k++) if (length(v[k] - res) < tolS) sup += w[k];
        const bool r2 = sup < MODEL_SUP * mass0;
#ifdef V35_DIAG
        r2Eval = true; r2Sup = !r2;
#endif
        if (r2) {
            const float cr = cRes >= 0.0 ? cRes : winCost(L, fOff, dir, b, res), cm = winCost(L, fOff, dir, b, v[25]);
            if (cm <= cr + REJ2.x + REJ2.y * cr) res = v[25];
#ifdef V35_DIAG
            else r2Cost = true;
#endif
        }
    }
#ifdef V35_DIAG
    // task 161 diagnosis (a build with a `#define V35_DIAG 1` at the top of this file only; the production build has none of it): the blocks of F01 where the model predicts more than
    // 2 full-resolution px with reliability above 0.5 (denominator) and this pass (the last of the level: iter 0) leaves the vector under 0.5 px (counted). Counters in G words
    // 3996 + 20 l (levels 0..4; the host dump carries them, gpu/v3flow.py g35[100 + 20 l + j]): j 0 denominator, 1 counted, 2..9 the rule that did it (exclusive, in this order: 2 HUD hold,
    // 3 too little vote mass, 4 the vote is zero and the model is no voter (weight under 0.05), 5 the vote is zero although the model voted (zero neighbours outvote it), 6 the vote moved
    // the block and the 3 % window-cost test rejected it, 7 R2 not taken: neighbours support the vector, 8 R2 not taken: the model's window cost too high, 9 other), 10..15 sums x 1000 of the window cost at the vector, at the model's,
    // the block's detail, r1, r2, |c0 - cM| / (detail + 2), 16..18 blocks where the model's window is better / equal / worse than the vector's (3 % + 0.05), 19 the sum of the vote confidence
    if (dir == 0 && pc.iter == 0 && l < 5 && hasM && mq > 0.5) {
        const float sc = exp2(float(l)) * float(pc.fscale);
        const int wo = gOff() + 3996 + 20 * l;
        if (length(v[25]) * sc > 2.0) {
            atomicAdd(ax[wo], 1u);
            if (length(res) * sc < 0.5) {
                atomicAdd(ax[wo + 1], 1u);
                const bool voteZero = length(vRes) * sc < 0.5;
                const bool voted = mass >= MMIN && !holdOwn;
                int cl = 7;
                if (holdOwn) cl = 0;
                else if (mass < MMIN) cl = 1;
                else if (voteZero) cl = w[25] < 0.05 ? 2 : 3;
                else if (length(vRes - own.xy) > 1e-3 && length(own.xy) * sc < 0.5) cl = 4;
                else if (r2Eval && r2Sup) cl = 5;
                else if (r2Eval && r2Cost) cl = 6;
                atomicAdd(ax[wo + 2 + cl], 1u);
                const float c0 = winCost(L, fOff, dir, b, res), cm = winCost(L, fOff, dir, b, v[25]);
                const float en = sen[ci];
                atomicAdd(ax[wo + 10], uint(1000.0 * min(c0, 60.0)));
                atomicAdd(ax[wo + 11], uint(1000.0 * min(cm, 60.0)));
                atomicAdd(ax[wo + 12], uint(1000.0 * min(en, 60.0)));
                atomicAdd(ax[wo + 13], uint(1000.0 * sr1[ci]));
                atomicAdd(ax[wo + 14], uint(1000.0 * sax[ci].w));
                atomicAdd(ax[wo + 15], uint(1000.0 * min(abs(c0 - cm) / (en + 2.0), 60.0)));
                atomicAdd(ax[wo + (cm < c0 - 0.05 - 0.02 * c0 ? 16 : cm > c0 + 0.05 + 0.02 * c0 ? 18 : 17)], 1u);
                atomicAdd(ax[wo + 19], uint(1000.0 * scol[ci].w));
            }
        }
    }
#endif
    const int o = v3BlkIdx(L, dir, sb, b);
    fl[o] = res.x; fl[o + 1] = res.y;
    if ((pc.mode & M35_L0) == 0) { fl[o + 2] = own.z; fl[o + 3] = own.w; }   // level 0: slot 1 keeps its z (the still-part evidence of the zero-vector bonus), slot 0 stays V3's own result
}
